    require(controller.markNativeReady(77, 71, OLD_REQUEST_ID), "throwing mover native ready");
    require(
        controller.scheduleIfReady(77, 71, OLD_REQUEST_ID),
        "throwing mover callback posts");

    scheduler.runNext();
    scheduler.runNext();
    scheduler.runNext();
    require(moveAdapter.calls == 3, "move exceptions stop at the production retry bound");
    require(observer.failedAttempts == 3, "each move exception maps to one refusal");
    require(observer.schedulerRejections == 0, "move exception is not scheduler refusal");
    require(observer.fallbacks == 1, "move exception exhaustion leaves Kodi foreground");
    require(!controller.owns(71, OLD_REQUEST_ID), "move exception fallback clears exact state");
    require(scheduler.size() == 0, "move exception exhaustion leaves no retry");
  }

  private static void warmTaskInitialPostRefusalRetriesExecutably() {
    FakeWarmTaskScheduler scheduler = new FakeWarmTaskScheduler();
    scheduler.enqueuePostResult(false);
