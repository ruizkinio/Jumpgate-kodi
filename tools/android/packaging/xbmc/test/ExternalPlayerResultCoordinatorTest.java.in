        warmTaskController(scheduler, lifecycleState, moveAdapter, observer);
    require(controller.prepare(71, 64, OLD_REQUEST_ID, true), "post-refusal handoff prepared");
    require(controller.markNativeReady(71, 64, OLD_REQUEST_ID), "post-refusal native ready");

    require(
        !controller.scheduleIfReady(71, 64, OLD_REQUEST_ID),
        "initial scheduler refusal is reported");
    require(scheduler.postCalls == 1, "initial post attempted once");
    require(scheduler.postDelayedCalls == 1, "scheduler refusal uses delayed retry");
    require(observer.failedAttempts == 1, "initial post refusal is observed once");
    require(observer.schedulerRejections == 1, "initial post refusal is classified safely");
    require(scheduler.size() == 1, "accepted delayed retry remains queued");
    scheduler.runNext();
    require(moveAdapter.calls == 1, "accepted retry executes the production move seam");
    require(!controller.owns(64, OLD_REQUEST_ID), "successful retry clears exact handoff");
    require(observer.fallbacks == 0, "successful retry avoids foreground fallback");
  }

