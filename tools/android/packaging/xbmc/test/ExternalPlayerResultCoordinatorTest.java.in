  private static void warmTaskNewerLaunchFencesQueuedControllerCallback() {
    FakeWarmTaskScheduler scheduler = new FakeWarmTaskScheduler();
    FakeWarmTaskLifecycleStateSource lifecycleState =
        new FakeWarmTaskLifecycleStateSource(74);
    FakeWarmTaskMoveAdapter moveAdapter = new FakeWarmTaskMoveAdapter();
    FakeWarmTaskObserver observer = new FakeWarmTaskObserver();
    ExternalPlayerResultCoordinator.WarmTaskHandoffController controller =
        warmTaskController(scheduler, lifecycleState, moveAdapter, observer);
    require(controller.prepare(74, 67, OLD_REQUEST_ID, true), "queued old handoff prepared");
    require(controller.markNativeReady(74, 67, OLD_REQUEST_ID), "queued old native ready");
    require(
        controller.scheduleIfReady(74, 67, OLD_REQUEST_ID),
        "queued old callback posts");

    require(controller.prepare(75, 68, NEW_REQUEST_ID, true), "newer launch replaces old state");
    lifecycleState.state =
        warmTaskLifecycleState(true, 75, false, false, false, 0, "");
    require(scheduler.removeCalls == 1, "newer launch requests exact callback removal");
    require(controller.markNativeReady(75, 68, NEW_REQUEST_ID), "newer native ready");
    require(
        controller.scheduleIfReady(75, 68, NEW_REQUEST_ID),
        "newer callback posts");
    require(scheduler.size() == 2, "removed old callback remains executable for race proof");

    scheduler.runNext();
    require(moveAdapter.calls == 0, "queued old callback cannot reach production move seam");
    require(controller.owns(68, NEW_REQUEST_ID), "old callback cannot clear newer authority");
    scheduler.runNext();
    require(moveAdapter.calls == 1, "newer exact callback moves once");
    require(moveAdapter.lastGeneration == 68, "only newer generation reaches task mover");
    require(NEW_REQUEST_ID.equals(moveAdapter.lastRequestId), "only newer request reaches mover");
    require(observer.fallbacks == 0, "stale queued callback cannot trigger fallback");
  }

  private static void warmTaskRetryCannotAttachToNewerSameLifecycleLaunch() {
    FakeWarmTaskScheduler scheduler = new FakeWarmTaskScheduler();
    FakeWarmTaskLifecycleStateSource lifecycleState =
        new FakeWarmTaskLifecycleStateSource(74);
    FakeWarmTaskMoveAdapter moveAdapter = new FakeWarmTaskMoveAdapter();
    moveAdapter.enqueue(false);
    AtomicReference<ExternalPlayerResultCoordinator.WarmTaskHandoffController> controllerRef =
        new AtomicReference<>();
    AtomicInteger failedAttempts = new AtomicInteger();
    AtomicInteger fallbacks = new AtomicInteger();
    ExternalPlayerResultCoordinator.WarmTaskHandoffObserver observer =
        new ExternalPlayerResultCoordinator.WarmTaskHandoffObserver() {
          @Override
          public void onAttemptFailed(
              int attemptNumber, int maxAttempts, boolean schedulerRejected) {
            require(attemptNumber == 1, "old launch reports only its first failed attempt");
            require(!schedulerRejected, "old move refusal is not a scheduler rejection");
            failedAttempts.incrementAndGet();
            ExternalPlayerResultCoordinator.WarmTaskHandoffController controller =
                controllerRef.get();
            require(
                controller.prepare(74, 68, NEW_REQUEST_ID, true),
                "newer launch replaces state before old retry scheduling");
            require(
                controller.markNativeReady(74, 68, NEW_REQUEST_ID),
                "newer same-lifecycle launch becomes ready");
          }

          @Override
          public void onFallback() {
            fallbacks.incrementAndGet();
          }
        };
    ExternalPlayerResultCoordinator.WarmTaskHandoffController controller =
        warmTaskController(scheduler, lifecycleState, moveAdapter, observer);
    controllerRef.set(controller);
    require(controller.prepare(74, 67, OLD_REQUEST_ID, true), "old retry owner prepared");
    require(controller.markNativeReady(74, 67, OLD_REQUEST_ID), "old retry owner ready");
    require(
        controller.scheduleIfReady(74, 67, OLD_REQUEST_ID),
        "old retry callback posts");

    scheduler.runNext();
    require(failedAttempts.get() == 1, "old refusal is observed once");
    require(scheduler.size() == 0, "old continuation cannot queue work for newer launch");
    require(controller.owns(68, NEW_REQUEST_ID), "newer exact authority remains ready");
    require(
        controller.scheduleIfReady(74, 68, NEW_REQUEST_ID),
        "newer owner schedules its own exact move");
    scheduler.runNext();
    require(moveAdapter.calls == 2, "old and newer owners each reach the mover once");
    require(moveAdapter.lastGeneration == 68, "newer generation owns the second move");
    require(NEW_REQUEST_ID.equals(moveAdapter.lastRequestId), "newer request owns the second move");
    require(moveAdapter.lastAttemptNumber == 1, "old retry cannot consume newer attempt budget");
    require(fallbacks.get() == 0, "newer-launch fencing does not trigger fallback");
  }

  private static void warmTaskDuplicateCallbacksAndNewerLaunchStayFenced() {
    ExternalPlayerResultCoordinator.WarmTaskHandoff handoff =
        new ExternalPlayerResultCoordinator.WarmTaskHandoff();
    require(handoff.prepare(72, 65, OLD_REQUEST_ID, false), "old handoff prepared");
    require(handoff.confirmCallerResult(0, OLD_REQUEST_ID), "old caller confirms by request");
    require(
        handoff.confirmCallerResult(0, OLD_REQUEST_ID),
        "duplicate request-scoped caller callback accepted");
    require(handoff.markNativeReady(72, 65, OLD_REQUEST_ID), "old native callback accepted");
    require(handoff.markNativeReady(72, 65, OLD_REQUEST_ID), "duplicate native callback accepted");
    ExternalPlayerResultCoordinator.WarmTaskHandoff.Attempt oldAttempt =
        handoff.reserveAttempt(72, 65, OLD_REQUEST_ID);
    require(oldAttempt != null, "old handoff reserves one callback");
    require(
        handoff.reserveAttempt(72, 65, OLD_REQUEST_ID) == null,
        "duplicate callback cannot reserve another move");

    require(handoff.prepare(73, 66, NEW_REQUEST_ID, false), "newer launch replaces old handoff");
    require(
        handoff.completeAttempt(oldAttempt, true)
            == ExternalPlayerResultCoordinator.WarmTaskMoveResult.STALE,
        "queued old callback cannot move newer launch");
    require(handoff.owns(66, NEW_REQUEST_ID), "newer launch keeps exact ownership");
    require(
        !handoff.confirmCallerResult(65, OLD_REQUEST_ID),
        "old caller callback cannot confirm newer launch");
    require(
        !handoff.markNativeReady(72, 65, OLD_REQUEST_ID),
        "old native callback cannot ready newer launch");
    require(handoff.confirmCallerResult(0, NEW_REQUEST_ID), "new caller confirms exactly");
    require(
        !handoff.markNativeReady(72, 66, NEW_REQUEST_ID),
        "stale lifecycle cannot ready newer launch");
    require(handoff.markNativeReady(73, 66, NEW_REQUEST_ID), "new lifecycle readies handoff");
    ExternalPlayerResultCoordinator.WarmTaskHandoff.Attempt newAttempt =
        handoff.reserveAttempt(73, 66, NEW_REQUEST_ID);
    require(newAttempt != null, "newer launch reserves exact move");
    require(
        handoff.completeAttempt(newAttempt, true)
            == ExternalPlayerResultCoordinator.WarmTaskMoveResult.MOVED,
        "newer exact callback moves task");
  }

  private static void normalTeardownTerminalizesExactOwnerOnce() {
    FakeHost host = new FakeHost();
    ExternalPlayerActivity.Controller controller =
        new ExternalPlayerActivity.Controller(host, freshOwner(OLD_REQUEST_ID));
    require(controller.forwardOnce(), "teardown owner forwarded");
    require(controller.bindGeneration(34), "teardown owner bound");
    require(
        !controller.cancelForTeardown(NEW_REQUEST_ID, 34),
        "wrong teardown request rejected");
    require(
        !controller.cancelForTeardown(OLD_REQUEST_ID, 35),
        "wrong teardown generation rejected");

    host.persistSucceeds = false;
    require(
        !controller.cancelForTeardown(OLD_REQUEST_ID, 34),
        "teardown cancellation stops when persistence fails");
    require(!controller.owner().wasCompleted(), "failed teardown remains retryable");
    require(host.setCanceledResultCalls == 0, "failed teardown exposes no canceled result");
    require(host.finishCalls == 0, "failed teardown does not finish owner");
    require(host.clearExactCalls == 0, "failed teardown does not clear owner");

    host.persistSucceeds = true;
    require(
        controller.cancelForTeardown(OLD_REQUEST_ID, 34),
        "exact normal teardown canceled caller");
    require(host.setCanceledResultCalls == 1, "teardown sets canceled result once");
    require(host.finishCalls == 1, "teardown finishes owner once");
    require(host.confirmWarmTaskHandoffCalls == 1, "teardown confirms canceled caller delivery");
    require(host.clearExactCalls == 1, "teardown clears exact durable owner");
    require(host.cancelNativeCalls == 0, "normal teardown does not call retired native app");
    require(
        !controller.cancelForTeardown(OLD_REQUEST_ID, 34),
        "duplicate teardown cannot redeliver result");
  }

  private static void activeTerminalReservationCanRetryAfterDurabilityFailure() {
    ExternalPlayerResultCoordinator.MainState state =
        new ExternalPlayerResultCoordinator.MainState();
    require(state.prepare(OLD_REQUEST_ID), "teardown request prepared");
    require(state.admitPrepared(35, OLD_REQUEST_ID) != null, "teardown request admitted");

    ExternalPlayerResultCoordinator.TerminalReservation failed =
        state.reserveFinish(35, OLD_REQUEST_ID, 20, 100, false, false);
    require(failed != null, "teardown terminal reserved");
    require(
        state.reserveFinish(35, OLD_REQUEST_ID, 20, 100, false, false) == null,
        "only one teardown terminal can be in flight");
    require(failed.rollback(), "failed teardown publication rolls back");
    require(state.activeGeneration() == 35, "failed teardown preserves generation");
    require(OLD_REQUEST_ID.equals(state.activeRequestId()), "failed teardown preserves owner");

    ExternalPlayerResultCoordinator.TerminalReservation retry =
        state.reserveFinish(35, OLD_REQUEST_ID, 20, 100, false, false);
    require(retry != null, "teardown terminal retries exactly");
    require(retry.commit(), "durable teardown terminal commits");
    require(!retry.commit(), "teardown reservation commits once");
    require(
        state.reserveFinish(35, OLD_REQUEST_ID, 20, 100, false, false) == null,
        "teardown owner receives one terminal");
  }

  private static void normalTerminalReservationCanRetryAfterDurabilityFailure() {
    ExternalPlayerResultCoordinator.MainState state =
        new ExternalPlayerResultCoordinator.MainState();
    require(state.prepare(OLD_REQUEST_ID), "normal terminal request prepared");
    require(state.admitPrepared(36, OLD_REQUEST_ID) != null, "normal terminal admitted");

    ExternalPlayerResultCoordinator.TerminalReservation failed =
        state.reserveFinish(36, OLD_REQUEST_ID, 70, 100, true, true);
    require(failed != null, "normal terminal reserved");
    require(
        !state.acknowledgeExit(36, OLD_REQUEST_ID),
        "uncommitted terminal cannot be acknowledged");
    require(failed.rollback(), "failed normal publication rolls back");

    ExternalPlayerResultCoordinator.TerminalReservation retry =
        state.reserveFinish(36, OLD_REQUEST_ID, 70, 100, true, true);
    require(retry != null, "normal terminal retries exactly");
    require(retry.commit(), "durable normal terminal commits");
    require(state.acknowledgeExit(36, OLD_REQUEST_ID), "committed terminal acknowledges");
    require(state.claimProcessExit(36, OLD_REQUEST_ID), "committed terminal exits once");
    require(!state.claimProcessExit(36, OLD_REQUEST_ID), "normal process exit remains one-shot");
  }

  private static void coldExitRequiresExactAcknowledgement() {
    ExternalPlayerResultCoordinator.Producer producer =
        new ExternalPlayerResultCoordinator.Producer();
    require(producer.begin(40, OLD_REQUEST_ID), "cold begin");
    require(producer.finish(40, OLD_REQUEST_ID, 40, 100, false, true) != null, "cold terminal");
    require(!producer.claimProcessExit(40, OLD_REQUEST_ID), "no exit before acknowledgement");
    require(!producer.acknowledgeExit(40, NEW_REQUEST_ID), "wrong owner acknowledgement");
    require(!producer.acknowledgeExit(41, OLD_REQUEST_ID), "wrong generation acknowledgement");
    require(producer.acknowledgeExit(40, OLD_REQUEST_ID), "exact acknowledgement");
    require(producer.claimProcessExit(40, OLD_REQUEST_ID), "single process-exit task claimed");
    require(!producer.claimProcessExit(40, OLD_REQUEST_ID), "no process-exit task loop");
    require(producer.shouldExitProcess(40, OLD_REQUEST_ID), "exact cold exit armed");
  }

  private static void mainDestroyedBeforeOwnerCallbackUsesDurableFallback() {
    ExternalPlayerResultCoordinator.ProcessExitState mainState =
        new ExternalPlayerResultCoordinator.ProcessExitState();
    require(mainState.activate(41, OLD_REQUEST_ID), "destroyed Main activated exact pair");
    require(mainState.requestExit(41, OLD_REQUEST_ID), "destroyed Main persisted cold exit");

    FakeHost recoveredHost = new FakeHost();
    recoveredHost.processExitState = mainState.copy();
    recoveredHost.processExitQueue = new DeterministicQueue();
    recoveredHost.mainCallbackAvailable = false;
    ExternalPlayerActivity.Controller recoveredOwner =
        new ExternalPlayerActivity.Controller(
            recoveredHost,
            new ExternalPlayerResultCoordinator.Owner(OLD_REQUEST_ID, true, 41, false, false));
    ExternalPlayerResultCoordinator.Terminal terminal =
        new ExternalPlayerResultCoordinator.Terminal(OLD_REQUEST_ID, 41, 25, 100, false, true);

    require(recoveredOwner.deliver(terminal), "owner callback survives destroyed Main");
    require(recoveredHost.acknowledgeCalls == 1, "durable acknowledgement recorded once");
    require(recoveredHost.processExitQueue.size() == 1, "activity fallback posted without Main");
    require(recoveredHost.processExitCalls == 0, "fallback waits for delivery callback boundary");
    recoveredHost.processExitQueue.runNext();
    require(recoveredHost.processExitCalls == 1, "fallback terminates the orphaned process");
    require(
        recoveredHost.processExitState.isClaimed(41, OLD_REQUEST_ID),
        "durable exact pair owns process exit");
  }

  private static void staleAcknowledgementIsRejected() {
    ExternalPlayerResultCoordinator.ProcessExitState processExit =
        new ExternalPlayerResultCoordinator.ProcessExitState();
    require(processExit.activate(42, OLD_REQUEST_ID), "old exit pair active");
    require(processExit.requestExit(42, OLD_REQUEST_ID), "old exit requested");
    require(processExit.activate(43, NEW_REQUEST_ID), "newer exit pair active");
    require(processExit.requestExit(43, NEW_REQUEST_ID), "newer exit requested");

    require(!processExit.acknowledge(42, OLD_REQUEST_ID), "stale pair cannot acknowledge");
    require(!processExit.acknowledge(43, OLD_REQUEST_ID), "wrong request cannot acknowledge");
    require(!processExit.acknowledge(42, NEW_REQUEST_ID), "wrong generation cannot acknowledge");
    require(processExit.acknowledge(43, NEW_REQUEST_ID), "exact newer pair acknowledges");
    require(!processExit.acknowledge(43, NEW_REQUEST_ID), "acknowledgement is one-shot");
  }

  private static void newerGenerationIsolatesQueuedExit() {
    ExternalPlayerResultCoordinator.ProcessExitState processExit =
        new ExternalPlayerResultCoordinator.ProcessExitState();
    DeterministicQueue queue = new DeterministicQueue();
    AtomicInteger processExits = new AtomicInteger();
    require(processExit.activate(44, OLD_REQUEST_ID), "queued old exit active");
    require(processExit.requestExit(44, OLD_REQUEST_ID), "queued old exit requested");
    require(processExit.acknowledge(44, OLD_REQUEST_ID), "queued old exit acknowledged");
    queue.post(
        () -> {
          if (processExit.claim(44, OLD_REQUEST_ID)) processExits.incrementAndGet();
        });

    require(processExit.activate(45, NEW_REQUEST_ID), "newer playback replaces exit authority");
    require(processExit.requestExit(45, NEW_REQUEST_ID), "newer playback requests its own exit");
    require(processExit.acknowledge(45, NEW_REQUEST_ID), "newer playback acknowledges exactly");
    queue.runNext();
    require(processExits.get() == 0, "queued stale exit cannot kill newer playback");
    require(processExit.claim(45, NEW_REQUEST_ID), "newer exact pair remains claimable");
    require(!processExit.claim(45, NEW_REQUEST_ID), "newer process exit claims once");
  }

  private static void duplicateTerminalRaceIsOneShot() throws Exception {
    for (int iteration = 0; iteration < 500; ++iteration) {
      FakeHost host = new FakeHost();
      ExternalPlayerActivity.Controller controller =
          new ExternalPlayerActivity.Controller(
              host,
              new ExternalPlayerResultCoordinator.Owner(THIRD_REQUEST_ID, true, 46, false, false));
      ExternalPlayerResultCoordinator.Terminal terminal =
          new ExternalPlayerResultCoordinator.Terminal(THIRD_REQUEST_ID, 46, 90, 100, true, false);
      CountDownLatch ready = new CountDownLatch(2);
      CountDownLatch start = new CountDownLatch(1);
      CountDownLatch done = new CountDownLatch(2);
      AtomicInteger deliveries = new AtomicInteger();
      AtomicReference<Throwable> failure = new AtomicReference<>();
      Runnable delivery =
          () -> {
            try {
              ready.countDown();
              if (!start.await(5, TimeUnit.SECONDS))
                throw new AssertionError("duplicate terminal start timeout");
              if (controller.deliver(terminal)) deliveries.incrementAndGet();
            } catch (Throwable throwable) {
              failure.compareAndSet(null, throwable);
            } finally {
              done.countDown();
            }
          };
      new Thread(delivery, "external-result-duplicate-a").start();
      new Thread(delivery, "external-result-duplicate-b").start();
      require(ready.await(5, TimeUnit.SECONDS), "duplicate terminal workers ready");
      start.countDown();
      require(done.await(5, TimeUnit.SECONDS), "duplicate terminal workers completed");
      if (failure.get() != null)
        throw new AssertionError("duplicate terminal worker failed", failure.get());
      require(deliveries.get() == 1, "duplicate terminal race has one winner");
      require(host.setTerminalResultCalls == 1, "duplicate race sets caller result once");
      require(host.finishCalls == 1, "duplicate race finishes owner once");
      require(host.clearExactCalls == 1, "duplicate race clears durable terminal once");
    }
  }

  private static void admissionRaceRejectsStaleTerminal() throws Exception {
    for (int iteration = 0; iteration < 1000; ++iteration) {
      ExternalPlayerResultCoordinator.MainState state =
          new ExternalPlayerResultCoordinator.MainState();
      require(state.prepare(OLD_REQUEST_ID), "race old prepare");
      require(state.admitPrepared(50, OLD_REQUEST_ID) != null, "race old admission");
      require(state.prepare(NEW_REQUEST_ID), "race replacement prepare");
      CountDownLatch replacementAdmitted = new CountDownLatch(1);
      AtomicInteger staleClaims = new AtomicInteger();
      AtomicReference<Throwable> failure = new AtomicReference<>();
      Thread staleTerminal =
          new Thread(
              () -> {
                try {
                  if (!replacementAdmitted.await(5, TimeUnit.SECONDS))
                    throw new AssertionError("race admission timeout");
                  if (state.finish(50, OLD_REQUEST_ID, 10, 100, false, true) != null)
                    staleClaims.incrementAndGet();
                } catch (Throwable throwable) {
                  failure.set(throwable);
                }
              },
              "external-result-stale-terminal");
      staleTerminal.start();
      ExternalPlayerResultCoordinator.TerminalReservation supersession =
          state.reserveSupersede(50, OLD_REQUEST_ID);
      require(supersession != null, "race supersession reserve");
      require(supersession.commit(), "race supersession commit");
      require(state.admitPrepared(51, NEW_REQUEST_ID) != null, "race replacement admission");
      replacementAdmitted.countDown();
      staleTerminal.join(TimeUnit.SECONDS.toMillis(5));
      require(!staleTerminal.isAlive(), "race worker completed");
      if (failure.get() != null) throw new AssertionError("race worker failed", failure.get());
      require(staleClaims.get() == 0, "stale generation never claimed");
    }
  }

  public static void main(String[] args) throws Exception {
    prePrepareCallerAcknowledgementConvergesThroughHandoff();
    staleAndRejectedCallerConfirmationsStayFenced();
    warmTaskMoveFailureRetriesWithoutLosingState();
    warmTaskProductionLifecycleGuardsFenceMove();
    warmTaskMoveExceptionRetriesToForegroundFallback();
    warmTaskInitialPostRefusalRetriesExecutably();
    warmTaskDelayedPostRefusalExhaustsToFallback();
    warmTaskMoveRetriesExhaustToForegroundFallback();
    warmTaskNewerLaunchFencesQueuedControllerCallback();
    warmTaskRetryCannotAttachToNewerSameLifecycleLaunch();
    warmTaskDuplicateCallbacksAndNewerLaunchStayFenced();
    for (int i = 0; i < 5000; ++i) {
      recreationPreservesForwardingAndExactBinding();
      processDeathRotatesOwnerWithoutStaleReplay();
      forwardingFailureCanRetrySafely();
      failedDurableDeliveryCanRetrySafely();
      cancellationUsesExactGeneration();
      overlappingLaunchesStayIsolated();
      preparedRejectionReleasesOnlyExactRequest();
      earlyBackCancellationIsRequestOwnedUntilExactAdmission();
      normalTeardownTerminalizesExactOwnerOnce();
      activeTerminalReservationCanRetryAfterDurabilityFailure();
      normalTerminalReservationCanRetryAfterDurabilityFailure();
      coldExitRequiresExactAcknowledgement();
      mainDestroyedBeforeOwnerCallbackUsesDurableFallback();
      staleAcknowledgementIsRejected();
      newerGenerationIsolatesQueuedExit();
    }
    admissionRaceRejectsStaleTerminal();
    duplicateTerminalRaceIsOneShot();
    System.out.println("ExternalPlayerResultCoordinatorTest: PASS");
  }
}
