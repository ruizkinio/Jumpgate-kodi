package @APP_PACKAGE@;

import java.util.ArrayDeque;
import java.util.concurrent.CountDownLatch;
import java.util.concurrent.TimeUnit;
import java.util.concurrent.atomic.AtomicInteger;
import java.util.concurrent.atomic.AtomicReference;

public final class ExternalPlayerResultCoordinatorTest {
  private static final String OLD_REQUEST_ID = "11111111-1111-4111-8111-111111111111";
  private static final String NEW_REQUEST_ID = "22222222-2222-4222-8222-222222222222";
  private static final String THIRD_REQUEST_ID = "33333333-3333-4333-8333-333333333333";

  private ExternalPlayerResultCoordinatorTest() {}

  private static final class DeterministicQueue {
    private final ArrayDeque<Runnable> mTasks = new ArrayDeque<>();

    synchronized void post(Runnable task) {
      mTasks.addLast(task);
    }

    void runNext() {
      Runnable task;
      synchronized (this) {
        task = mTasks.removeFirst();
      }
      task.run();
    }

    synchronized int size() {
      return mTasks.size();
    }
  }

  private static final class FakeWarmTaskScheduler
      implements ExternalPlayerResultCoordinator.WarmTaskScheduler {
    private final ArrayDeque<Runnable> mTasks = new ArrayDeque<>();
    private final ArrayDeque<Boolean> mPostResults = new ArrayDeque<>();
    private final ArrayDeque<Boolean> mDelayedResults = new ArrayDeque<>();
    int postCalls;
    int postDelayedCalls;
    int removeCalls;

    void enqueuePostResult(boolean result) {
      mPostResults.addLast(result);
    }

    void enqueueDelayedResult(boolean result) {
      mDelayedResults.addLast(result);
    }

    @Override
    public boolean post(Runnable callback) {
      ++postCalls;
      boolean accepted = mPostResults.isEmpty() || mPostResults.removeFirst();
      if (accepted) mTasks.addLast(callback);
      return accepted;
    }

    @Override
    public boolean postDelayed(Runnable callback, long delayMs) {
      require(delayMs >= 0, "scheduler delay is nonnegative");
      ++postDelayedCalls;
      boolean accepted = mDelayedResults.isEmpty() || mDelayedResults.removeFirst();
      if (accepted) mTasks.addLast(callback);
      return accepted;
    }

    @Override
    public void removeCallbacks(Runnable callback) {
      ++removeCalls;
      // Keep queued callbacks so tests execute the race Handler.removeCallbacks cannot prevent.
    }

    void runNext() {
      mTasks.removeFirst().run();
    }

    int size() {
      return mTasks.size();
    }
  }

  private static final class FakeWarmTaskLifecycleStateSource
      implements ExternalPlayerResultCoordinator.WarmTaskLifecycleStateSource {
    ExternalPlayerResultCoordinator.WarmTaskLifecycleState state;
    int captures;

    FakeWarmTaskLifecycleStateSource(long lifecycleToken) {
      state = warmTaskLifecycleState(true, lifecycleToken, false, false, false, 0, "");
    }

    @Override
    public ExternalPlayerResultCoordinator.WarmTaskLifecycleState capture() {
      require(Thread.holdsLock(this), "production lifecycle capture holds the activity lock");
      ++captures;
      return state;
    }
  }

  private static final class FakeWarmTaskMoveAdapter
      implements ExternalPlayerResultCoordinator.WarmTaskMoveAdapter {
    private final ArrayDeque<Boolean> mResults = new ArrayDeque<>();
    private int mFailures;
    Object expectedLifecycleLock;
    int calls;
    long lastGeneration;
    String lastRequestId = "";
    int lastAttemptNumber;

    void enqueue(boolean result) {
      mResults.addLast(result);
    }

    void enqueueFailure() {
      ++mFailures;
    }

    @Override
    public boolean moveTaskToBack(
        ExternalPlayerResultCoordinator.WarmTaskHandoff.Attempt attempt) {
      require(
          expectedLifecycleLock == null || Thread.holdsLock(expectedLifecycleLock),
          "production task move holds the activity lock");
      ++calls;
      lastGeneration = attempt.generation();
      lastRequestId = attempt.requestId();
      lastAttemptNumber = attempt.number();
      if (mFailures > 0) {
        --mFailures;
        throw new IllegalStateException("simulated moveTaskToBack failure");
      }
      return mResults.isEmpty() || mResults.removeFirst();
    }
  }

  private static final class FakeWarmTaskObserver
      implements ExternalPlayerResultCoordinator.WarmTaskHandoffObserver {
    int failedAttempts;
    int schedulerRejections;
    int fallbacks;

    @Override
    public void onAttemptFailed(
        int attemptNumber, int maxAttempts, boolean schedulerRejected) {
      require(attemptNumber > 0 && attemptNumber <= maxAttempts, "attempt diagnostics bounded");
      ++failedAttempts;
      if (schedulerRejected) ++schedulerRejections;
    }

    @Override
    public void onFallback() {
      ++fallbacks;
    }
  }

  private static ExternalPlayerResultCoordinator.WarmTaskHandoffController warmTaskController(
      FakeWarmTaskScheduler scheduler,
      FakeWarmTaskLifecycleStateSource lifecycleState,
      FakeWarmTaskMoveAdapter moveAdapter,
      ExternalPlayerResultCoordinator.WarmTaskHandoffObserver observer) {
    moveAdapter.expectedLifecycleLock = lifecycleState;
    return new ExternalPlayerResultCoordinator.WarmTaskHandoffController(
        scheduler, lifecycleState, lifecycleState, moveAdapter, observer, 100);
  }

  private static ExternalPlayerResultCoordinator.WarmTaskLifecycleState warmTaskLifecycleState(
      boolean currentActivity,
      long lifecycleToken,
      boolean finishing,
      boolean destroyed,
      boolean externalPlayerMode,
      long activeGeneration,
      String preparedRequestId) {
    return new ExternalPlayerResultCoordinator.WarmTaskLifecycleState(
        currentActivity,
        lifecycleToken,
        finishing,
        destroyed,
        externalPlayerMode,
        activeGeneration,
        preparedRequestId);
  }

  private static final class FakeHost implements ExternalPlayerActivity.Host {
    boolean persistSucceeds = true;
    boolean startSucceeds = true;
    ExternalPlayerResultCoordinator.Owner persistedOwner;
    ExternalPlayerResultCoordinator.Terminal deliveredTerminal;
    String forwardedRequestId;
    String clearedRequestId;
    long clearedGeneration;
    String canceledRequestId;
    long canceledGeneration;
    int persistCalls;
    int startCalls;
    int setTerminalResultCalls;
    int setCanceledResultCalls;
    int finishCalls;
    int clearExactCalls;
    int clearUnboundCalls;
    int cancelNativeCalls;
    int acknowledgeCalls;
    int confirmWarmTaskHandoffCalls;
    int processExitCalls;
    final StringBuilder deliveryOrder = new StringBuilder();
    boolean mainCallbackAvailable = true;
    ExternalPlayerResultCoordinator.ProcessExitState processExitState;
    DeterministicQueue processExitQueue;

    @Override
    public synchronized boolean persist(ExternalPlayerResultCoordinator.Owner owner) {
      ++persistCalls;
      if (!persistSucceeds) return false;
      persistedOwner = owner.copy();
      return true;
    }

    @Override
    public synchronized boolean startMain(String requestId) {
      ++startCalls;
      forwardedRequestId = requestId;
      return startSucceeds;
    }

    @Override
    public synchronized void setTerminalResult(ExternalPlayerResultCoordinator.Terminal terminal) {
      ++setTerminalResultCalls;
      deliveredTerminal = terminal;
      deliveryOrder.append("result;");
    }

    @Override
    public synchronized void setCanceledResult() {
      ++setCanceledResultCalls;
    }

    @Override
    public synchronized void finishOwner() {
      ++finishCalls;
      deliveryOrder.append("finish;");
    }

    @Override
    public synchronized void clearExact(String requestId, long generation) {
      ++clearExactCalls;
      clearedRequestId = requestId;
      clearedGeneration = generation;
      deliveryOrder.append("clear;");
      if (processExitState != null) processExitState.clear(generation, requestId);
    }

    @Override
    public synchronized void clearUnbound(String requestId) {
      ++clearUnboundCalls;
      clearedRequestId = requestId;
    }

    @Override
    public synchronized void cancelNative(String requestId, long generation) {
      ++cancelNativeCalls;
      canceledRequestId = requestId;
      canceledGeneration = generation;
    }

    @Override
    public synchronized boolean acknowledge(ExternalPlayerResultCoordinator.Terminal terminal) {
      ++acknowledgeCalls;
      deliveryOrder.append("acknowledge;");
      if (processExitState == null) return true;
      if (!processExitState.acknowledge(terminal.generation, terminal.requestId)) return false;

      if (mainCallbackAvailable) postProcessExit(terminal);
      postProcessExit(terminal);
      return true;
    }

    @Override
    public synchronized void confirmWarmTaskHandoff(long generation, String requestId) {
      ++confirmWarmTaskHandoffCalls;
      deliveryOrder.append("confirm;");
    }

    private void postProcessExit(ExternalPlayerResultCoordinator.Terminal terminal) {
      if (processExitQueue == null)
        throw new AssertionError("process-exit queue must be configured");
      processExitQueue.post(
          () -> {
            if (!processExitState.claim(terminal.generation, terminal.requestId)) return;
            synchronized (FakeHost.this) {
              ++processExitCalls;
            }
          });
    }
  }

  private static ExternalPlayerResultCoordinator.Owner freshOwner(String requestId) {
    return new ExternalPlayerResultCoordinator.Owner(requestId, false, 0, false, false);
  }

  private static void require(boolean condition, String message) {
    if (!condition) throw new AssertionError(message);
  }

  private static void recreationPreservesForwardingAndExactBinding() {
    FakeHost host = new FakeHost();
    ExternalPlayerActivity.Controller first =
        new ExternalPlayerActivity.Controller(host, freshOwner(OLD_REQUEST_ID));
    require(first.forwardOnce(), "initial launch forwards");
    require(host.startCalls == 1, "one Main launch");
    require(host.persistedOwner.wasLaunchForwarded(), "forwarded state durable before launch");

    ExternalPlayerActivity.Controller beforeBinding =
        new ExternalPlayerActivity.Controller(host, host.persistedOwner.copy());
    require(!beforeBinding.forwardOnce(), "recreation never re-forwards an admitted launch");
    require(host.startCalls == 1, "Main liveness cannot trigger duplicate forwarding");
    require(beforeBinding.bindGeneration(7), "native generation binds exact owner");

    ExternalPlayerActivity.Controller afterBinding =
        new ExternalPlayerActivity.Controller(host, host.persistedOwner.copy());
    require(afterBinding.owner().expectedGeneration() == 7, "generation survives recreation");
    require(
        !afterBinding.deliver(
            new ExternalPlayerResultCoordinator.Terminal(OLD_REQUEST_ID, 6, 10, 100, false, false)),
        "stale generation rejected");
    require(
        !afterBinding.deliver(
            new ExternalPlayerResultCoordinator.Terminal(NEW_REQUEST_ID, 7, 10, 100, false, false)),
        "wrong request rejected");

    ExternalPlayerResultCoordinator.Terminal terminal =
        new ExternalPlayerResultCoordinator.Terminal(OLD_REQUEST_ID, 7, 50, 100, false, true);
    require(afterBinding.deliver(terminal), "exact terminal delivered");
    require(!afterBinding.deliver(terminal), "terminal delivered once");
    require(host.setTerminalResultCalls == 1, "setResult once");
    require(host.finishCalls == 1, "finish once");
    require(host.clearExactCalls == 0, "acknowledged cold state retained for recovery");
    require(host.acknowledgeCalls == 1, "process exit acknowledged once");
    require(host.persistedOwner.wasCompleted(), "completed owner remains durable");
  }

  private static void processDeathRotatesOwnerWithoutStaleReplay() {
    FakeHost host = new FakeHost();
    host.processExitState = new ExternalPlayerResultCoordinator.ProcessExitState();
    require(host.processExitState.activate(10, OLD_REQUEST_ID), "old process authority active");
    ExternalPlayerActivity.Controller controller =
        new ExternalPlayerActivity.Controller(host, freshOwner(OLD_REQUEST_ID));
    require(controller.forwardOnce(), "old process launch");
    require(controller.bindGeneration(10), "old process binding");

    host.persistSucceeds = false;
    require(
        !controller.recoverAfterProcessDeath(NEW_REQUEST_ID),
        "replacement waits for durable owner persistence");
    require(controller.needsProcessRecovery(), "failed replacement preserves recovery authority");
    require(
        OLD_REQUEST_ID.equals(controller.owner().requestId()),
        "failed replacement preserves old in-memory owner");
    require(host.clearExactCalls == 0, "failed replacement does not clear old durable owner");
    require(host.startCalls == 1, "failed replacement does not launch Main");

    host.persistSucceeds = true;
    require(controller.recoverAfterProcessDeath(NEW_REQUEST_ID), "dead process recovery forwards");
    require(host.clearExactCalls == 1, "stale exact owner cleared");
    require(host.clearedGeneration == 10, "stale generation cleared exactly");
    require(!host.processExitState.isActive(), "recovery invalidates stale process authority");
    require(host.startCalls == 2, "replacement launch forwarded once");
    require(NEW_REQUEST_ID.equals(host.forwardedRequestId), "replacement gets fresh request");
    require(controller.owner().expectedGeneration() == 0, "replacement starts unbound");
    require(
        !controller.deliver(
            new ExternalPlayerResultCoordinator.Terminal(OLD_REQUEST_ID, 10, 30, 100, false, true)),
        "dead-process terminal cannot cross owner");
    require(controller.bindGeneration(11), "replacement receives new generation");
    require(host.processExitState.activate(11, NEW_REQUEST_ID), "replacement authority active");
    require(host.processExitState.requestExit(11, NEW_REQUEST_ID), "replacement exit requested");
    host.processExitQueue = new DeterministicQueue();
    require(
        controller.deliver(
            new ExternalPlayerResultCoordinator.Terminal(NEW_REQUEST_ID, 11, 40, 100, true, true)),
        "replacement exact result delivered");
  }

  private static void forwardingFailureCanRetrySafely() {
    FakeHost host = new FakeHost();
    ExternalPlayerActivity.Controller controller =
        new ExternalPlayerActivity.Controller(host, freshOwner(OLD_REQUEST_ID));
    host.persistSucceeds = false;
    require(!controller.forwardOnce(), "launch blocked when durable write fails");
    require(host.startCalls == 0, "Main not launched without durable forwarding marker");

    host.persistSucceeds = true;
    host.startSucceeds = false;
    require(!controller.forwardOnce(), "failed Main launch rolls back forwarding");
    require(!controller.owner().wasLaunchForwarded(), "failed launch remains retryable");

    host.startSucceeds = true;
    require(controller.forwardOnce(), "retry forwards once");
    require(controller.owner().wasLaunchForwarded(), "retry durable forwarding state");
  }

  private static void failedDurableDeliveryCanRetrySafely() {
    FakeHost host = new FakeHost();
    ExternalPlayerActivity.Controller controller =
        new ExternalPlayerActivity.Controller(
            host,
            new ExternalPlayerResultCoordinator.Owner(
                OLD_REQUEST_ID, true, 22, false, false));
    ExternalPlayerResultCoordinator.Terminal terminal =
        new ExternalPlayerResultCoordinator.Terminal(
            OLD_REQUEST_ID, 22, 25, 100, false, false);

    host.persistSucceeds = false;
    require(!controller.deliver(terminal), "delivery stops when completion is not durable");
    require(!controller.owner().wasCompleted(), "failed durability leaves delivery retryable");
    require(host.setTerminalResultCalls == 0, "failed durability exposes no caller result");
    require(host.finishCalls == 0, "failed durability does not finish the owner");
    require(host.clearExactCalls == 0, "failed durability does not clear the terminal");

    host.persistSucceeds = true;
    require(controller.deliver(terminal), "durable delivery retry succeeds");
    require(!controller.deliver(terminal), "durable retry still delivers only once");
    require(host.setTerminalResultCalls == 1, "retry exposes one caller result");
    require(host.finishCalls == 1, "retry finishes the owner once");
    require(host.confirmWarmTaskHandoffCalls == 1, "warm delivery confirms one task handoff");
    require(
        "result;finish;confirm;clear;".contentEquals(host.deliveryOrder),
        "warm handoff follows caller result and finish before exact cleanup");
    require(host.clearExactCalls == 1, "retry clears the exact terminal once");
  }

  private static void cancellationUsesExactGeneration() {
    FakeHost retryHost = new FakeHost();
    ExternalPlayerActivity.Controller retry =
        new ExternalPlayerActivity.Controller(
            retryHost,
            new ExternalPlayerResultCoordinator.Owner(
                OLD_REQUEST_ID, true, 19, false, false));
    retryHost.persistSucceeds = false;
    require(!retry.cancelForCaller(), "caller cancellation waits for durable persistence");
    require(!retry.owner().wasCompleted(), "failed cancellation remains retryable");
    require(retryHost.setCanceledResultCalls == 0, "failed cancellation exposes no result");
    require(retryHost.finishCalls == 0, "failed cancellation does not finish owner");
    require(retryHost.cancelNativeCalls == 0, "failed cancellation does not cancel native owner");
    retryHost.persistSucceeds = true;
    require(retry.cancelForCaller(), "durable caller cancellation retries");
    require(retryHost.setCanceledResultCalls == 1, "retry exposes one canceled result");
    require(retryHost.finishCalls == 1, "retry finishes owner once");
    require(retryHost.confirmWarmTaskHandoffCalls == 1, "canceled owner confirms caller delivery");
    require(
        "finish;confirm;".contentEquals(retryHost.deliveryOrder),
        "canceled-owner confirmation follows caller finish");
    require(retryHost.cancelNativeCalls == 1, "retry cancels exact native owner once");

    FakeHost unforwardedHost = new FakeHost();
    ExternalPlayerActivity.Controller unforwarded =
        new ExternalPlayerActivity.Controller(unforwardedHost, freshOwner(OLD_REQUEST_ID));
    require(unforwarded.cancelForCaller(), "pre-forward cancellation");
    require(unforwardedHost.setCanceledResultCalls == 1, "caller canceled once");
    require(unforwardedHost.finishCalls == 1, "pre-forward owner finished once");
    require(unforwardedHost.clearUnboundCalls == 1, "unadmitted owner safely cleared");
    require(unforwardedHost.cancelNativeCalls == 0, "no generation canceled before admission");

    FakeHost pendingHost = new FakeHost();
    ExternalPlayerActivity.Controller pending =
        new ExternalPlayerActivity.Controller(pendingHost, freshOwner(NEW_REQUEST_ID));
    require(pending.forwardOnce(), "pending launch forwarded");
    require(pending.cancelForCaller(), "forwarded-unbound caller canceled");
    require(pendingHost.clearUnboundCalls == 0, "pending cancellation stays durable for binding");
    ExternalPlayerResultCoordinator.Owner pendingRecord = pendingHost.persistedOwner.copy();
    require(pendingRecord.bind(20, NEW_REQUEST_ID), "canceled request can bind exact admission");
    require(pendingRecord.wasCanceled(), "pending cancellation remains attached to binding");

    FakeHost boundHost = new FakeHost();
    ExternalPlayerActivity.Controller bound =
        new ExternalPlayerActivity.Controller(boundHost, freshOwner(THIRD_REQUEST_ID));
    require(bound.forwardOnce(), "bound launch forwarded");
    require(bound.bindGeneration(21), "bound launch generation");
    require(bound.cancelForCaller(), "bound owner canceled");
    require(boundHost.cancelNativeCalls == 1, "native cancellation once");
    require(THIRD_REQUEST_ID.equals(boundHost.canceledRequestId), "native request exact");
    require(boundHost.canceledGeneration == 21, "native generation exact");
    require(!bound.cancelForCaller(), "duplicate cancellation rejected");
  }

  private static void overlappingLaunchesStayIsolated() {
    ExternalPlayerResultCoordinator.MainState state =
        new ExternalPlayerResultCoordinator.MainState();
    require(state.prepare(OLD_REQUEST_ID), "old request prepared through Main state");
    require(state.admitPrepared(30, OLD_REQUEST_ID) != null, "old generation admitted");
    require(state.ownsRequest(OLD_REQUEST_ID), "active request deduplicated before JNI");
    require(state.prepare(NEW_REQUEST_ID), "replacement prepares while old generation is active");
    require(state.activeGeneration() == 30, "preparation does not replace active generation");
    require(OLD_REQUEST_ID.equals(state.activeRequestId()), "old request remains active");
    ExternalPlayerResultCoordinator.TerminalReservation failedSupersession =
        state.reserveSupersede(30, OLD_REQUEST_ID);
    require(failedSupersession != null, "old supersession reserved");
    require(
        state.admitPrepared(31, NEW_REQUEST_ID) == null,
        "replacement waits for durable old supersession");
    require(failedSupersession.rollback(), "failed supersession rolls back");
    require(
        state.admitPrepared(31, NEW_REQUEST_ID) == null,
        "rollback keeps the old owner active");

    ExternalPlayerResultCoordinator.TerminalReservation supersession =
        state.reserveSupersede(30, OLD_REQUEST_ID);
    require(supersession != null, "exact supersession retry reserved");
    ExternalPlayerResultCoordinator.Terminal superseded = supersession.terminal();
    require(supersession.commit(), "durable supersession committed");
    require(superseded != null && superseded.failedToStart(), "old generation superseded");
    require(
        state.reserveSupersede(30, OLD_REQUEST_ID) == null,
        "old supersession is one-shot");
    require(
        state.admitPrepared(31, NEW_REQUEST_ID) != null,
        "replacement generation admitted after old supersession");
    require(
        state.finish(30, OLD_REQUEST_ID, 10, 100, false, true) == null,
        "old native terminal rejected");

    FakeHost oldHost = new FakeHost();
    ExternalPlayerResultCoordinator.Owner oldOwner =
        new ExternalPlayerResultCoordinator.Owner(OLD_REQUEST_ID, true, 30, false, false);
    ExternalPlayerActivity.Controller oldController =
        new ExternalPlayerActivity.Controller(oldHost, oldOwner);
    FakeHost newHost = new FakeHost();
    ExternalPlayerResultCoordinator.Owner newOwner =
        new ExternalPlayerResultCoordinator.Owner(NEW_REQUEST_ID, true, 31, false, false);
    ExternalPlayerActivity.Controller newController =
        new ExternalPlayerActivity.Controller(newHost, newOwner);
    require(oldController.deliver(superseded), "old owner gets old supersession");
    require(!newController.deliver(superseded), "replacement rejects old supersession");
    ExternalPlayerResultCoordinator.Terminal replacement =
        state.finish(31, NEW_REQUEST_ID, 80, 100, true, false);
    require(
        newController.deliver(replacement),
        "replacement gets replacement terminal");
    require(
        state.finish(31, NEW_REQUEST_ID, 80, 100, true, false) == null,
        "replacement terminal is one-shot");
  }

  private static void preparedRejectionReleasesOnlyExactRequest() {
    ExternalPlayerResultCoordinator.MainState state =
        new ExternalPlayerResultCoordinator.MainState();
    require(state.prepare(OLD_REQUEST_ID), "old request prepared through Main state");
    require(state.admitPrepared(32, OLD_REQUEST_ID) != null, "old request admitted");
    require(state.prepare(NEW_REQUEST_ID), "incoming request prepared beside active owner");
    require(
        state.reservePreparedRejection(1L << 62, THIRD_REQUEST_ID) == null,
        "wrong prepared request cannot be consumed");

    ExternalPlayerResultCoordinator.TerminalReservation failedRejection =
        state.reservePreparedRejection(1L << 62, NEW_REQUEST_ID);
    require(failedRejection != null, "exact prepared rejection reserved");
    require(
        state.admitPrepared(33, NEW_REQUEST_ID) == null,
        "prepared rejection reservation blocks admission");
    require(failedRejection.rollback(), "failed prepared rejection rolls back");
    require(state.isPrepared(NEW_REQUEST_ID), "failed rejection remains retryable");
    require(state.activeGeneration() == 32, "failed rejection preserves active generation");
    require(OLD_REQUEST_ID.equals(state.activeRequestId()), "failed rejection preserves owner");

    ExternalPlayerResultCoordinator.TerminalReservation rejectionReservation =
        state.reservePreparedRejection(1L << 62, NEW_REQUEST_ID);
    require(rejectionReservation != null, "exact prepared rejection retries");
    ExternalPlayerResultCoordinator.Terminal rejection = rejectionReservation.terminal();
    require(rejectionReservation.commit(), "durable prepared rejection commits");
    require(rejection != null && rejection.failedToStart(), "exact prepared request rejected");
    require(
        state.reservePreparedRejection((1L << 62) + 1, NEW_REQUEST_ID) == null,
        "prepared rejection is one-shot");
    require(state.activeGeneration() == 32, "rejection preserves active generation");
    require(OLD_REQUEST_ID.equals(state.activeRequestId()), "rejection preserves active owner");
    require(
        state.finish(32, OLD_REQUEST_ID, 40, 100, false, false) != null,
        "active owner still receives its terminal");

    require(state.prepare(THIRD_REQUEST_ID), "later distinct request is not wedged");
    require(
        state.admitPrepared(33, THIRD_REQUEST_ID) != null,
        "later distinct request is admitted normally");
    require(
        state.finish(33, THIRD_REQUEST_ID, 60, 100, true, false) != null,
        "later owner receives one terminal");
    require(
        state.finish(33, THIRD_REQUEST_ID, 60, 100, true, false) == null,
        "later owner cannot receive a duplicate terminal");
  }

  private static void earlyBackCancellationIsRequestOwnedUntilExactAdmission() {
    ExternalPlayerResultCoordinator.Producer producer =
        new ExternalPlayerResultCoordinator.Producer();
    require(producer.prepare(OLD_REQUEST_ID), "cold request prepared before native admission");
    require(
        !producer.cancelPrepared(NEW_REQUEST_ID),
        "wrong request cannot consume early Back ownership");
    require(producer.cancelPrepared(OLD_REQUEST_ID), "exact early Back recorded once");
    require(producer.cancelPrepared(OLD_REQUEST_ID), "duplicate early Back is idempotent");

    ExternalPlayerResultCoordinator.Admission admission =
        producer.admitPrepared(32, OLD_REQUEST_ID);
    require(admission != null, "prepared request receives native generation");
    require(admission.wasCancellationRequested(), "early Back follows exact admission");
    require(
        producer.admitPrepared(32, OLD_REQUEST_ID) == null,
        "prepared cancellation is atomically consumed once");
    require(
        producer.finish(32, OLD_REQUEST_ID, 0, 0, false, true) != null,
        "canceled admission still owns one caller terminal");

    require(producer.prepare(NEW_REQUEST_ID), "replacement request prepares independently");
    ExternalPlayerResultCoordinator.Admission replacement =
        producer.admitPrepared(33, NEW_REQUEST_ID);
    require(replacement != null, "replacement admission accepted");
    require(!replacement.wasCancellationRequested(), "old cancellation cannot cross requests");
  }

  private static void prePrepareCallerAcknowledgementConvergesThroughHandoff() {
    ExternalPlayerResultCoordinator.Producer producer =
        new ExternalPlayerResultCoordinator.Producer();
    require(
        producer.confirmCallerResult(0, OLD_REQUEST_ID),
        "exact caller acknowledgement is retained before preparation");
    require(
        producer.confirmCallerResult(0, OLD_REQUEST_ID),
        "duplicate pre-prepare acknowledgement is idempotent");
    require(
        !producer.confirmCallerResult(0, NEW_REQUEST_ID),
        "another request cannot replace pending acknowledgement authority");
    require(producer.prepare(OLD_REQUEST_ID), "acknowledged request prepares exactly");
    require(producer.cancelPrepared(OLD_REQUEST_ID), "forwarded request canceled before binding");
    require(
        !producer.confirmCallerResult(60, OLD_REQUEST_ID),
        "unbound generation confirmation rejected");

    ExternalPlayerResultCoordinator.Admission admission =
        producer.admitPrepared(60, OLD_REQUEST_ID);
    require(admission != null, "canceled request later binds its native generation");
    require(admission.wasCancellationRequested(), "cancellation follows exact later binding");
    require(
        admission.wasCallerResultAcknowledged(),
        "caller acknowledgement follows exact later binding");
    require(
        producer.isCallerResultAcknowledged(60, OLD_REQUEST_ID),
        "bound generation retains caller acknowledgement");
    require(
        !producer.isCallerResultAcknowledged(60, NEW_REQUEST_ID),
        "bound acknowledgement rejects another request");
    require(
        !producer.isCallerResultAcknowledged(61, OLD_REQUEST_ID),
        "bound acknowledgement rejects another generation");
    require(
        producer.finish(60, OLD_REQUEST_ID, 0, 0, false, false) != null,
        "canceled binding reaches one terminal");
    require(
        producer.isCallerResultAcknowledged(60, OLD_REQUEST_ID),
        "terminal convergence retains caller acknowledgement");

    FakeWarmTaskScheduler scheduler = new FakeWarmTaskScheduler();
    FakeWarmTaskLifecycleStateSource lifecycleState =
        new FakeWarmTaskLifecycleStateSource(70);
    FakeWarmTaskMoveAdapter moveAdapter = new FakeWarmTaskMoveAdapter();
    FakeWarmTaskObserver observer = new FakeWarmTaskObserver();
    ExternalPlayerResultCoordinator.WarmTaskHandoffController handoff =
        warmTaskController(scheduler, lifecycleState, moveAdapter, observer);
    require(
        handoff.prepare(70, 60, OLD_REQUEST_ID, admission.wasCallerResultAcknowledged()),
        "exited exact request prepares warm handoff");
    require(handoff.markNativeReady(70, 60, OLD_REQUEST_ID), "native exit readies handoff");
    require(
        handoff.scheduleIfReady(70, 60, OLD_REQUEST_ID),
        "acknowledged handoff posts exactly");
    scheduler.runNext();
    require(moveAdapter.calls == 1, "acknowledged exited request moves once");
    require(!handoff.owns(60, OLD_REQUEST_ID), "completed handoff clears exact owner");
    require(observer.fallbacks == 0, "successful exact handoff needs no fallback");

    ExternalPlayerResultCoordinator.Producer lateConfirmation =
        new ExternalPlayerResultCoordinator.Producer();
    require(lateConfirmation.prepare(NEW_REQUEST_ID), "late-confirmation request prepared");
    require(
        lateConfirmation.cancelPrepared(NEW_REQUEST_ID),
        "late-confirmation request canceled before binding");
    require(
        lateConfirmation.admitPrepared(61, NEW_REQUEST_ID) != null,
        "late-confirmation cancellation binds before callback");
    require(
        lateConfirmation.confirmCallerResult(0, NEW_REQUEST_ID),
        "request-scoped acknowledgement follows exact later binding");
    require(
        lateConfirmation.isCallerResultAcknowledged(61, NEW_REQUEST_ID),
        "late request acknowledgement binds to the current exact generation");
  }

  private static void staleAndRejectedCallerConfirmationsStayFenced() {
    ExternalPlayerResultCoordinator.Producer producer =
        new ExternalPlayerResultCoordinator.Producer();
    require(
        producer.confirmCallerResult(0, OLD_REQUEST_ID),
        "unprepared exact confirmation is retained");
    require(
        !producer.confirmCallerResult(0, NEW_REQUEST_ID),
        "different unprepared confirmation cannot replace exact pending state");
    require(producer.prepare(NEW_REQUEST_ID), "newer preparation fences stale pending state");
    ExternalPlayerResultCoordinator.Admission replacement =
        producer.admitPrepared(61, NEW_REQUEST_ID);
    require(replacement != null, "newer owner admitted exactly");
    require(
        !replacement.wasCallerResultAcknowledged(),
        "stale request acknowledgement cannot cross into newer preparation");
    require(
        !producer.confirmCallerResult(0, OLD_REQUEST_ID),
        "stale request cannot confirm active newer owner");
    require(producer.finish(61, NEW_REQUEST_ID, 1, 10, false, false) != null, "new terminal");
    producer.clear(61, NEW_REQUEST_ID);

    require(producer.prepare(THIRD_REQUEST_ID), "later confirmation owner prepared");
    require(
        !producer.confirmCallerResult(0, OLD_REQUEST_ID),
        "stale request cannot confirm newer preparation");
    require(producer.confirmCallerResult(0, THIRD_REQUEST_ID), "later request confirms exactly");
    require(producer.admitPrepared(62, THIRD_REQUEST_ID) != null, "later owner admitted exactly");
    require(
        !producer.isCallerResultAcknowledged(61, NEW_REQUEST_ID),
        "newer launch fences stale acknowledged pair");
    require(
        producer.isCallerResultAcknowledged(62, THIRD_REQUEST_ID),
        "newer launch retains only its exact acknowledgement");
  }

  private static void warmTaskMoveFailureRetriesWithoutLosingState() {
    ExternalPlayerResultCoordinator.WarmTaskHandoff handoff =
        new ExternalPlayerResultCoordinator.WarmTaskHandoff();
    require(handoff.prepare(70, 63, OLD_REQUEST_ID, true), "warm handoff prepared");
    require(handoff.markNativeReady(70, 63, OLD_REQUEST_ID), "native cleanup confirmed");

    ExternalPlayerResultCoordinator.WarmTaskHandoff.Attempt first =
        handoff.reserveAttempt(70, 63, OLD_REQUEST_ID);
    require(first != null && first.number() == 1, "first task move reserved");
    require(
        handoff.completeAttempt(first, false)
            == ExternalPlayerResultCoordinator.WarmTaskMoveResult.RETRY,
        "Android task-move refusal requests a bounded retry");
    require(handoff.owns(63, OLD_REQUEST_ID), "failed task move retains exact handoff state");

    ExternalPlayerResultCoordinator.WarmTaskHandoff.Attempt retry =
        handoff.reserveAttempt(70, 63, OLD_REQUEST_ID);
    require(retry != null && retry.number() == 2, "task move retried once");
    require(
        handoff.completeAttempt(retry, true)
            == ExternalPlayerResultCoordinator.WarmTaskMoveResult.MOVED,
        "successful retry completes handoff");
    require(!handoff.owns(63, OLD_REQUEST_ID), "successful task move clears exact state");
    require(
        handoff.completeAttempt(retry, true)
            == ExternalPlayerResultCoordinator.WarmTaskMoveResult.STALE,
        "duplicate task-move callback is stale");
  }

  private static void warmTaskProductionLifecycleGuardsFenceMove() {
    ExternalPlayerResultCoordinator.WarmTaskLifecycleState[] blockedStates = {
      warmTaskLifecycleState(false, 76, false, false, false, 0, ""),
      warmTaskLifecycleState(true, 0, false, false, false, 0, ""),
      warmTaskLifecycleState(true, 77, false, false, false, 0, ""),
      warmTaskLifecycleState(true, 76, true, false, false, 0, ""),
      warmTaskLifecycleState(true, 76, false, true, false, 0, ""),
      warmTaskLifecycleState(true, 76, false, false, true, 0, ""),
      warmTaskLifecycleState(true, 76, false, false, false, 70, ""),
      warmTaskLifecycleState(true, 76, false, false, false, 0, NEW_REQUEST_ID),
    };

    for (int guard = 0; guard < blockedStates.length; ++guard) {
      FakeWarmTaskScheduler scheduler = new FakeWarmTaskScheduler();
      FakeWarmTaskLifecycleStateSource lifecycleState =
          new FakeWarmTaskLifecycleStateSource(76);
      lifecycleState.state = blockedStates[guard];
      FakeWarmTaskMoveAdapter moveAdapter = new FakeWarmTaskMoveAdapter();
      FakeWarmTaskObserver observer = new FakeWarmTaskObserver();
      ExternalPlayerResultCoordinator.WarmTaskHandoffController controller =
          warmTaskController(scheduler, lifecycleState, moveAdapter, observer);
      require(controller.prepare(76, 70, OLD_REQUEST_ID, true), "guarded handoff prepared");
      require(controller.markNativeReady(76, 70, OLD_REQUEST_ID), "guarded native ready");
      require(
          controller.scheduleIfReady(76, 70, OLD_REQUEST_ID),
          "guarded callback reaches production lifecycle seam");

      scheduler.runNext();
      require(lifecycleState.captures == 1, "production lifecycle state captured once");
      require(moveAdapter.calls == 0, "failed lifecycle guard fences Android task move");
      require(observer.failedAttempts == 0, "stale lifecycle is not retried as refusal");
      require(observer.fallbacks == 1, "stale lifecycle selects safe foreground fallback");
      require(!controller.owns(70, OLD_REQUEST_ID), "lifecycle fallback clears exact handoff");
      require(scheduler.size() == 0, "lifecycle fallback leaves no queued callback");
    }
  }

  private static void warmTaskMoveExceptionRetriesToForegroundFallback() {
    FakeWarmTaskScheduler scheduler = new FakeWarmTaskScheduler();
