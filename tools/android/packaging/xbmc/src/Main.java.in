  private LoadingPortalSurfaceView mLoadingPortalSurface = null;
  private String mLoadingOverlayRequestId = "";
  private ImageView mOverlayBackdropView = null;
  private View mOverlayLogoPulseContainer = null;
  private View mOverlayProgressFill = null;
