  private class DelayedIntent
  {
    public final Intent mIntent;
    public final long mLifecycleToken;
    public final String mPreparedRequestId;

    public DelayedIntent(Intent intent, long lifecycleToken, String preparedRequestId) {
      mIntent = intent;
      mLifecycleToken = lifecycleToken;
      mPreparedRequestId = preparedRequestId == null ? "" : preparedRequestId;
    }
  }
  private ArrayList<DelayedIntent> mDelayedIntents = new ArrayList<>();
  private boolean mNativeIntentReady = false;
  private boolean mPaused = true;
  private static boolean mActivityRunning = false;

  // Launchers that support the Recommended Content API
  private final Set<String> mRecommendedLaunchers = new HashSet<String>() {{
    add("com.google.android.tvlauncher"); // Android TV Stock
    add("com.spocky.projengmenu"); // Projectivy Launcher
  }};

  native void _onNewIntent(long lifecycleToken, Intent intent, String preparedRequestId);

  native void _onActivityResult(
      long lifecycleToken, int requestCode, int resultCode, Intent resultData);

  native long _onBackCreated(boolean externalPlayerMode);
  native void _onBackStarted(long lifecycleToken, int swipeEdge);
  native void _onBackLongPress(long lifecycleToken);
  native void _onBackCancelled(long lifecycleToken);
  native void _onBackInvoked(long lifecycleToken);
  native void _onBackDestroyed(long lifecycleToken);

  native void _doFrame(long lifecycleToken, long frameTimeNanos);

  native void _onVisibleBehindCanceled(long lifecycleToken);

  @SuppressWarnings("deprecation")
  private static void normalizeLongExtraAsString(Intent intent, String name) {
    if (intent == null || !intent.hasExtra(name) || intent.getExtras() == null) return;
    Object value = intent.getExtras().get(name);
    if (value instanceof Long) intent.putExtra(name, Long.toString((Long) value));
  }

  private Runnable leanbackUpdateRunnable =
      new Runnable() {
        @Override
        public void run() {
          Log.d(TAG, "Main: Updating recommendations");
          new Thread() {
            public void run() {
              mJsonRPC.updateLeanback(Main.this);
            }
          }.start();
          handler.postDelayed(
              this, XBMCProperties.getIntProperty("xbmc.leanbackrefresh", 60 * 60) * 1000L);
        }
      };

  public Main()
  {
    super();
    mWarmTaskHandoff =
        new ExternalPlayerResultCoordinator.WarmTaskHandoffController(
            new ExternalPlayerResultCoordinator.WarmTaskScheduler() {
              @Override
              public boolean post(Runnable callback) {
                return handler.post(callback);
              }

              @Override
              public boolean postDelayed(Runnable callback, long delayMs) {
                return handler.postDelayed(callback, delayMs);
              }

              @Override
              public void removeCallbacks(Runnable callback) {
                handler.removeCallbacks(callback);
              }
            },
            Main.this,
            this::captureWarmTaskLifecycleState,
            attempt -> moveTaskToBack(true),
            new ExternalPlayerResultCoordinator.WarmTaskHandoffObserver() {
              @Override
              public void onAttemptFailed(
                  int attemptNumber, int maxAttempts, boolean schedulerRejected) {
                String refusal = schedulerRejected ? "Main looper refused" : "Android refused";
                Log.w(
                    TAG,
                    "Main: "
                        + refusal
                        + " warm task handoff attempt "
                        + attemptNumber
                        + " of "
                        + maxAttempts);
              }

              @Override
              public void onFallback() {
                Log.w(TAG, "Main: Warm task handoff unavailable; leaving Kodi in foreground");
              }
            },
            WARM_TASK_HANDOFF_RETRY_DELAY_MS);
    MainActivity = this;
  }

  private synchronized ExternalPlayerResultCoordinator.WarmTaskLifecycleState
      captureWarmTaskLifecycleState() {
    return new ExternalPlayerResultCoordinator.WarmTaskLifecycleState(
        MainActivity == this,
        mBackLifecycleToken,
        isFinishing(),
        isDestroyed(),
        mExternalPlayerMode,
        mExternalResultProducer.activeGeneration(),
        mExternalResultProducer.preparedRequestId());
  }

  public Rect getDisplayRect()
  {
    Rect ret = new Rect();
    ret.top = 0;
    ret.left = 0;
    ret.right = 0;
    ret.bottom = 0;

    try
    {
      ret.right = mDecorView.getRootView().getWidth();
      ret.bottom = mDecorView.getRootView().getHeight();
    }
    catch (Exception e)
    {
      Log.d(TAG, "Main: Exception: " + e.getMessage());
    }

    return ret;
  }

  @Override
  public void onCreate(Bundle savedInstanceState)
  {
    normalizeLongExtraAsString(getIntent(), "extra_position");
    normalizeLongExtraAsString(getIntent(), "position");
    normalizeLongExtraAsString(getIntent(), "startfrom");
    if (getIntent().getData() != null && Intent.ACTION_VIEW.equals(getIntent().getAction()))
      getIntent().putExtra("jumpgate_launched_at_ms", Long.toString(System.currentTimeMillis()));

    // Detect external player mode BEFORE native engine starts so we can
    // show the loading overlay before Kodi's native init renders anything
    mExternalPlayerMode = getIntent().getBooleanExtra("external_player_mode", false);
    if (mExternalPlayerMode) {
      Log.d(TAG, "Main: External player mode activated");
      getWindow().setBackgroundDrawable(new ColorDrawable(Color.BLACK));
    }

    String initialRequestId =
        getIntent().getStringExtra(ExternalPlayerResultCoordinator.EXTRA_REQUEST_ID);
    if (mExternalPlayerMode && !ExternalPlayerResultCoordinator.isValidRequestId(initialRequestId))
      throw new IllegalStateException("External player launch has no valid result owner");
    if (mExternalPlayerMode) {
      if (!mExternalResultProducer.prepare(initialRequestId))
        throw new IllegalStateException("External result request ownership preparation failed");
      cancelPendingWarmTaskHandoff();
    }

    System.loadLibrary("@APP_NAME_LC@");

    mBackLifecycleToken = _onBackCreated(mExternalPlayerMode);
    if (mBackLifecycleToken == 0)
      throw new IllegalStateException("Native Back lifecycle creation failed");
    super.onCreate(savedInstanceState);
    registerApi36BackCallback();

    setContentView(R.layout.activity_main);
    setVolumeControlStream(AudioManager.STREAM_MUSIC);

    mSettingsContentObserver =
        new XBMCSettingsContentObserver(this, handler, mBackLifecycleToken);
    getApplicationContext().getContentResolver().registerContentObserver(android.provider.Settings.System.CONTENT_URI, true, mSettingsContentObserver);

    // Native publishes readiness after Kodi's application and messenger are initialized.
    if (getIntent().getData() != null)
    {
      mDelayedIntents.add(
          new DelayedIntent(
              new Intent(getIntent()), mBackLifecycleToken, initialRequestId));
      getIntent().setData(null);
    }

    if (getPackageManager().hasSystemFeature(FEATURE_LEANBACK))
    {
      if (Build.VERSION.SDK_INT >= VERSION_CODES.O
          && mRecommendedLaunchers.contains(getLauncherName()))
      {
        TvUtil.scheduleSyncingChannel(this);
      }
      else if (Build.VERSION.SDK_INT < VERSION_CODES.O
               && getLauncherName().equals("com.google.android.leanbacklauncher"))
      {
        // Leanback
        mJsonRPC = new XBMCJsonRPC(getApplicationContext());
        handler.removeCallbacks(leanbackUpdateRunnable);
        handler.postDelayed(leanbackUpdateRunnable, 30 * 1000);
      }
    }

    // register the InputDeviceListener implementation
    mInputDeviceListener = new XBMCInputDeviceListener(mBackLifecycleToken);
    InputManager manager = (InputManager) getSystemService(INPUT_SERVICE);
    manager.registerInputDeviceListener(mInputDeviceListener, handler);

    mDecorView = getWindow().getDecorView();
    // In external player mode, keep black background so native init isn't visible
    // behind the loading overlay. Normal mode clears background for Kodi's own rendering.
    if (!mExternalPlayerMode) {
      mDecorView.setBackground(null);
    }
    getWindow().takeSurface(null);
    setContentView(R.layout.activity_main);
    RelativeLayout videoLayout = findViewById(R.id.VideoLayout);

    mMainView = new XBMCMainView(this);
    RelativeLayout.LayoutParams layoutParams = new RelativeLayout.LayoutParams(RelativeLayout.LayoutParams.MATCH_PARENT, RelativeLayout.LayoutParams.MATCH_PARENT);
    mMainView.setElevation(1);  // Always on Top
    videoLayout.addView(mMainView, layoutParams);

    // Keep the portal in this activity's only application window. A separate WindowManager
    // surface can race Android TV display/task transitions while the SurfaceView is recreated.
    if (mExternalPlayerMode)
      showLoadingOverlay(getIntent());

    registerLegacySystemUiVisibilityListener();
  }

  @SuppressWarnings("deprecation")
  private void registerLegacySystemUiVisibilityListener()
  {
    if (Build.VERSION.SDK_INT >= 30)
      return;

    mDecorView.setOnSystemUiVisibilityChangeListener(new View.OnSystemUiVisibilityChangeListener()
    {
      @Override
      public void onSystemUiVisibilityChange(int visibility)
      {
        if ((visibility & View.SYSTEM_UI_FLAG_HIDE_NAVIGATION) == 0)
        {
          handler.post(new Runnable()
          {
            public void run()
            {
              mDecorView.setSystemUiVisibility(
                  View.SYSTEM_UI_FLAG_LAYOUT_STABLE
                      | View.SYSTEM_UI_FLAG_LAYOUT_HIDE_NAVIGATION
                      | View.SYSTEM_UI_FLAG_LAYOUT_FULLSCREEN
                      | View.SYSTEM_UI_FLAG_HIDE_NAVIGATION
                      | View.SYSTEM_UI_FLAG_FULLSCREEN
                      | View.SYSTEM_UI_FLAG_IMMERSIVE_STICKY);
            }
          });
        }
      }
    });
  }

  @Override
  protected void onNewIntent(Intent intent)
  {
    super.onNewIntent(intent);

    normalizeLongExtraAsString(intent, "extra_position");
    normalizeLongExtraAsString(intent, "position");
    normalizeLongExtraAsString(intent, "startfrom");

    if (intent.getData() != null && Intent.ACTION_VIEW.equals(intent.getAction()))
      intent.putExtra("jumpgate_launched_at_ms", Long.toString(System.currentTimeMillis()));

    // If we receive an ACTION_VIEW while already running, we're transitioning from
    // standalone to external player mode. Track this so we return to standalone after playback.
    boolean isActionView = intent.getData() != null
            && Intent.ACTION_VIEW.equals(intent.getAction());
    String externalRequestId =
        intent.getStringExtra(ExternalPlayerResultCoordinator.EXTRA_REQUEST_ID);
    if (isActionView && mExternalResultProducer.ownsRequest(externalRequestId)) {
      Log.w(TAG, "Main: Ignoring duplicate external playback request " + externalRequestId);
      return;
    }
    if (isActionView) {
      synchronized (this) {
        if (!mExternalResultProducer.prepare(externalRequestId)) {
          Log.e(TAG, "Main: Rejecting unowned external playback request " + externalRequestId);
          return;
        }
        cancelPendingWarmTaskHandoff();
      }
    }
    boolean wasAlreadyExternal = mExternalPlayerMode;

    // Show loading overlay for external player transitions
    if (isActionView)
    {
      showLoadingOverlay(intent);
      Log.d(TAG, "Main: Loading overlay shown (warm transition)");
    }

    // Queue until both Android resume and native application readiness are proven.
    if (mPaused || !mNativeIntentReady)
    {
      Log.d(TAG, "Main: onNewIntent (delayed)");
      if (isActionView && !wasAlreadyExternal)
      {
        mPendingWasStandalone = true;
      }
      mDelayedIntents.add(
          new DelayedIntent(
              new Intent(intent),
              mBackLifecycleToken,
              isActionView ? externalRequestId : ""));
    }
    else
    {
      Log.d(TAG, "Main: onNewIntent (immediate)");
      if (isActionView)
      {
        if (!wasAlreadyExternal)
        {
          mWasStandalone = true;
          Log.d(TAG, "Main: Warm transition to external player mode (standalone was running)");
        }
        mExternalPlayerMode = true;
      }
      _onNewIntent(
          mBackLifecycleToken, intent, isActionView ? externalRequestId : "");
    }
  }

  @Override
  public void onStart()
  {
    super.onStart();
    mActivityRunning = true;

    Choreographer.getInstance().removeFrameCallback(this);
    Choreographer.getInstance().postFrameCallback(this);
  }

  @Override
  @SuppressWarnings("deprecation")
  public void onResume()
  {
    super.onResume();

    if (Build.VERSION.SDK_INT >= 30)
    {
      getWindow().setDecorFitsSystemWindows(false);
      WindowInsetsController controller = getWindow().getInsetsController();
      if (controller != null)
      {
        controller.hide(WindowInsets.Type.statusBars() | WindowInsets.Type.navigationBars());
        controller.setSystemBarsBehavior(WindowInsetsController.BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE);
      }
    }
    else
    {
      // Immersive mode
      mDecorView.setSystemUiVisibility(
          View.SYSTEM_UI_FLAG_LAYOUT_STABLE
                  | View.SYSTEM_UI_FLAG_LAYOUT_HIDE_NAVIGATION
                  | View.SYSTEM_UI_FLAG_LAYOUT_FULLSCREEN
                  | View.SYSTEM_UI_FLAG_HIDE_NAVIGATION
                  | View.SYSTEM_UI_FLAG_FULLSCREEN
                  | View.SYSTEM_UI_FLAG_IMMERSIVE_STICKY);
    }

    // New intent ?
    // If we had a pending warm-transition flag from onNewIntent, apply it now
    if (mPendingWasStandalone)
    {
      mWasStandalone = true;
      mExternalPlayerMode = true;
      mPendingWasStandalone = false;
      Log.d(TAG, "Main: Warm transition to external player mode (delayed, standalone was running)");
    }
    mPaused = false;
    resumeLoadingOverlayAnimations();
    dispatchPendingNativeIntents();
  }

  /** Called by native after the application messenger can accept exact playback work. */
  public void onNativeIntentReady(long lifecycleToken) {
    runOnUiThread(
        () -> {
          if (lifecycleToken == 0 || lifecycleToken != mBackLifecycleToken || isFinishing()) return;
          mNativeIntentReady = true;
          dispatchPendingNativeIntents();
        });
  }

  private void dispatchPendingNativeIntents() {
    if (mPaused || !mNativeIntentReady || mDelayedIntents.isEmpty()) return;

    ArrayList<DelayedIntent> ready = new ArrayList<>(mDelayedIntents);
    mDelayedIntents.clear();
    for (DelayedIntent pending : ready) {
      try {
        _onNewIntent(pending.mLifecycleToken, pending.mIntent, pending.mPreparedRequestId);
      } catch (UnsatisfiedLinkError e) {
        Log.e(TAG, "Main: Native intent target disappeared", e);
        postDeferredExternalPlayerRejection(
            pending.mLifecycleToken, pending.mPreparedRequestId);
      }
    }
  }

  @Override
  public void onPause()
  {
    super.onPause();

    if (getPackageManager().hasSystemFeature(FEATURE_LEANBACK)
        && Build.VERSION.SDK_INT >= VERSION_CODES.O
        && mRecommendedLaunchers.contains(getLauncherName())) {
      TvUtil.scheduleSyncingChannel(this);
    }

    mPaused = true;
    pauseLoadingOverlayAnimations();
  }

  @Override
  public void onActivityResult(int requestCode, int resultCode,
                               Intent resultData)
  {
    super.onActivityResult(requestCode, resultCode, resultData);
    _onActivityResult(mBackLifecycleToken, requestCode, resultCode, resultData);
  }

  private void registerApi36BackCallback()
  {
    if (Build.VERSION.SDK_INT < 36 || mOnBackAnimationCallback != null)
      return;

    mOnBackAnimationCallback = PredictiveBackApi36.register(this, mBackLifecycleToken);
  }

  private void unregisterApi36BackCallback()
  {
    Object callback = mOnBackAnimationCallback;
    mOnBackAnimationCallback = null;
    if (Build.VERSION.SDK_INT < 36 || callback == null)
      return;

    PredictiveBackApi36.unregister(this, callback);
  }

  @TargetApi(36)
  private static final class PredictiveBackApi36
  {
    static Object register(final Main activity, final long lifecycleToken)
    {
      OnBackAnimationCallback callback = new OnBackAnimationCallback()
      {
        @Override
        public void onBackStarted(BackEvent backEvent)
        {
          int swipeEdge = backEvent.getSwipeEdge();
          int source = BACK_SOURCE_GESTURE_LEFT;
          if (swipeEdge == BackEvent.EDGE_RIGHT)
            source = BACK_SOURCE_GESTURE_RIGHT;
          else if (swipeEdge == BackEvent.EDGE_NONE)
            source = BACK_SOURCE_BUTTON;
          activity.handler.removeCallbacks(activity.mBackLongPressRunnable);
          activity._onBackStarted(lifecycleToken, source);
          if (swipeEdge == BackEvent.EDGE_NONE)
            activity.handler.postDelayed(
                activity.mBackLongPressRunnable, BACK_LONG_PRESS_THRESHOLD_MS);
        }

        @Override
        public void onBackCancelled()
        {
          activity.handler.removeCallbacks(activity.mBackLongPressRunnable);
          activity._onBackCancelled(lifecycleToken);
        }

        @Override
        public void onBackInvoked()
        {
          activity.handler.removeCallbacks(activity.mBackLongPressRunnable);
          activity._onBackInvoked(lifecycleToken);
        }
      };
      activity.getOnBackInvokedDispatcher().registerOnBackInvokedCallback(
          OnBackInvokedDispatcher.PRIORITY_DEFAULT, callback);
      return callback;
    }

    static void unregister(Main activity, Object callback)
    {
      activity.getOnBackInvokedDispatcher().unregisterOnBackInvokedCallback(
          (OnBackAnimationCallback) callback);
    }
  }

  public long getBackLifecycleToken()
  {
    return mBackLifecycleToken;
  }

  @Override
  public void onDestroy()
  {
    detachLoadingOverlayImmediately();
    cancelPendingWarmTaskHandoff();
    handler.removeCallbacks(mBackLongPressRunnable);
    unregisterApi36BackCallback();
    terminalizeExternalPlayerResultForTeardown();
    final long lifecycleToken = mBackLifecycleToken;
    mBackLifecycleToken = 0;
    if (lifecycleToken != 0)
      _onBackDestroyed(lifecycleToken);

    TvUtil.cancelAllScheduledJobs(this);

    // unregister the InputDeviceListener implementation
    InputManager manager = (InputManager) getSystemService(INPUT_SERVICE);
    manager.unregisterInputDeviceListener(mInputDeviceListener);

    getApplicationContext().getContentResolver().unregisterContentObserver(mSettingsContentObserver);
    if (MainActivity == this)
    {
      MainActivity = null;
      mActivityRunning = false;
      Intent wakeup = new Intent(ExternalPlayerResultCoordinator.ACTION_MAIN_DESTROYED);
      wakeup.setPackage(getPackageName());
      getApplicationContext().sendBroadcast(wakeup);
    }
    super.onDestroy();
  }

  public static boolean isActivityRunning() {
    return mActivityRunning;
  }

  @Override
  @SuppressWarnings("deprecation")
  public void onVisibleBehindCanceled()
  {
    _onVisibleBehindCanceled(mBackLifecycleToken);
    super.onVisibleBehindCanceled();
  }

  @Override
  public void doFrame(long frameTimeNanos)
  {
    Choreographer.getInstance().postFrameCallback(this);
    _doFrame(mBackLifecycleToken, frameTimeNanos);
  }

  private native void _callNative(long funcAddr, long variantAddr);

  private void runNativeOnUiThread(final long funcAddr, final long variantAddr)
  {
    runOnUiThread(new Runnable()
    {
      @Override
      public void run()
      {
        _callNative(funcAddr, variantAddr);
      }
    });
  }

  /**
   * Gets the package name of the current system launcher
   */
  private String getLauncherName() {
    String name = "";
    final Intent intent = new Intent(Intent.ACTION_MAIN);
    intent.addCategory(Intent.CATEGORY_HOME);
    final ResolveInfo res = getPackageManager().resolveActivity(intent, 0);
    if (res != null) {
      name = res.activityInfo.packageName;
    }
    return name;
  }

  // --- External Player Mode ---

  private void postNativeExternalIntentRetry(
      long lifecycleToken, Intent intent, String preparedRequestId) {
    if (intent == null
        || lifecycleToken == 0
        || lifecycleToken != mBackLifecycleToken
        || intent.getIntExtra(NATIVE_INTENT_RETRY, 0) >= MAX_NATIVE_INTENT_RETRIES) {
      postDeferredExternalPlayerRejection(lifecycleToken, preparedRequestId);
      return;
    }

    final Intent retryIntent = new Intent(intent);
    retryIntent.putExtra(
        NATIVE_INTENT_RETRY, intent.getIntExtra(NATIVE_INTENT_RETRY, 0) + 1);
    final String exactRequestId = preparedRequestId == null ? "" : preparedRequestId;
    if (!handler.postDelayed(
        () -> {
          if (lifecycleToken != mBackLifecycleToken) {
            postDeferredExternalPlayerRejection(lifecycleToken, exactRequestId);
            return;
          }
          _onNewIntent(lifecycleToken, retryIntent, exactRequestId);
        },
        16L)) {
      postDeferredExternalPlayerRejection(lifecycleToken, exactRequestId);
    }
  }

  private void postDeferredExternalPlayerRejection(
      long lifecycleToken, String preparedRequestId) {
    if (!ExternalPlayerResultCoordinator.isValidRequestId(preparedRequestId)) return;

    final long generation;
    synchronized (this) {
      if (lifecycleToken != mBackLifecycleToken
          || !mExternalResultProducer.isPrepared(preparedRequestId)) return;
      generation = mDeferredRejectionGeneration++;
    }

    Runnable rejection = () -> rejectExternalPlayerResult(generation, preparedRequestId);
    if (!handler.post(rejection)) {
      // At most one exact prepared request can own this Main instance, so this
      // fallback is bounded even while its Looper is shutting down.
      new Thread(rejection, "jumpgate-result-rejection").start();
    }
  }

  public synchronized boolean beginExternalPlayerMode(
      long generation, String requestId, boolean wasStandalone) {
    ExternalPlayerResultCoordinator.Admission admission =
        mExternalResultProducer.admitPrepared(generation, requestId);
    if (admission == null) {
      Log.e(TAG, "Main: External playback lacked exact prepared request ownership");
      hideLoadingOverlayForRequest(requestId);
      return true;
    }
    cancelPendingWarmTaskHandoff();

    boolean cancellationRequested = admission.wasCancellationRequested();
    ExternalPlayerResultCoordinator.Owner owner =
        ExternalPlayerResultStore.bindActive(this, requestId, generation);
    if (owner == null) {
      Log.e(
          TAG,
          "Main: External playback has no forwarded result owner for generation " + generation);
      mExternalResultProducer.cancelOwner(generation, requestId);
      cancellationRequested = true;
    } else if (owner.wasCanceled()) {
      mExternalResultProducer.cancelOwner(generation, requestId);
      cancellationRequested = true;
    }

    mExternalPlayerMode = true;
    mWasStandalone = wasStandalone;
    return cancellationRequested;
  }

  public synchronized boolean isExternalPlayerResultCanceled(long generation, String requestId) {
    return mExternalResultProducer.isOwnerCanceled(generation, requestId);
  }

  public synchronized boolean recordEarlyExternalPlayerBack() {
    return mExternalResultProducer.cancelEarlyBack();
  }

  public boolean postExternalPlayerResultConvergence(long callbackAddress, long payloadAddress) {
    if (callbackAddress == 0 || payloadAddress == 0) return false;
    return handler.post(() -> _callNative(callbackAddress, payloadAddress));
  }

  private boolean publishExternalPlayerTerminalOrClearCanceledOwner(
      ExternalPlayerResultCoordinator.Terminal terminal) {
    ExternalPlayerResultCoordinator.Owner owner =
        ExternalPlayerResultStore.readOwner(this, terminal.requestId);
    if (owner != null
        && owner.expectedGeneration() == terminal.generation
        && owner.wasCanceled()) {
      return ExternalPlayerResultStore.clear(this, terminal.requestId, terminal.generation);
    }
    return ExternalPlayerResultStore.publish(this, terminal);
  }

  private synchronized void terminalizeExternalPlayerResultForTeardown() {
    String preparedRequestId = mExternalResultProducer.preparedRequestId();
    if (ExternalPlayerResultCoordinator.isValidRequestId(preparedRequestId))
      rejectExternalPlayerResult(mDeferredRejectionGeneration++, preparedRequestId);

    long activeGeneration = mExternalResultProducer.activeGeneration();
    String activeRequestId = mExternalResultProducer.activeRequestId();
    if (activeGeneration <= 0
        || !ExternalPlayerResultCoordinator.isValidRequestId(activeRequestId)) return;

    ExternalPlayerResultCoordinator.TerminalReservation reservation =
        mExternalResultProducer.reserveFinish(
            activeGeneration,
            activeRequestId,
            mLastPlaybackPosition,
            mLastPlaybackDuration,
            false,
            false);
    if (reservation == null) return;

    ExternalPlayerResultCoordinator.Terminal terminal = reservation.terminal();
    if (!publishExternalPlayerTerminalOrClearCanceledOwner(terminal)) {
      reservation.rollback();
      Log.e(TAG, "Main: Could not persist exact teardown terminal");
      return;
    }
    if (!reservation.commit())
      throw new IllegalStateException("Exact teardown terminal reservation changed");
  }

  public synchronized void supersedeExternalPlayerResult(long generation, String requestId) {
    ExternalPlayerResultCoordinator.TerminalReservation reservation =
        mExternalResultProducer.reserveSupersede(generation, requestId);
    if (reservation == null) {
      Log.d(TAG, "Main: Ignoring stale external player supersession " + generation);
      return;
    }

    if (!publishExternalPlayerTerminalOrClearCanceledOwner(reservation.terminal())) {
      reservation.rollback();
      Log.e(TAG, "Main: Could not persist superseded external player result");
      return;
    }
    if (!reservation.commit())
      throw new IllegalStateException("Exact supersession reservation changed");
  }

  public synchronized void rejectExternalPlayerResult(long generation, String requestId) {
    ExternalPlayerResultCoordinator.TerminalReservation reservation =
        mExternalResultProducer.reservePreparedRejection(generation, requestId);
    if (reservation == null) {
      Log.d(TAG, "Main: Ignoring stale prepared rejection " + generation);
      return;
    }

    ExternalPlayerResultCoordinator.Owner owner =
        ExternalPlayerResultStore.bind(this, requestId, generation);
    if (owner == null) {
      reservation.rollback();
      Log.e(TAG, "Main: Rejected playback has no exact result owner " + generation);
      return;
    }
    if (owner.wasCanceled()) {
      if (!ExternalPlayerResultStore.clear(this, requestId, generation)) {
        reservation.rollback();
        Log.e(TAG, "Main: Could not clear exact canceled rejected owner " + generation);
        return;
      }
    } else if (!ExternalPlayerResultStore.publish(this, reservation.terminal())) {
      reservation.rollback();
      Log.e(TAG, "Main: Could not persist rejected external player result");
      return;
    }
    if (!reservation.commit())
      throw new IllegalStateException("Exact prepared rejection reservation changed");
  }

  /**
   * Called from native code when playback position updates
   */
  public void updatePlaybackPosition(long positionMs, long durationMs) {
    mLastPlaybackPosition = positionMs;
    mLastPlaybackDuration = durationMs;

    if (mLoadingOverlay == null) {
      return;
    }

    runOnUiThread(() -> {
      if (mLoadingOverlay == null) {
        return;
      }

      if (durationMs > 0 && mOverlayProgress < 88) {
        setLoadingOverlayProgress(88);
      }

      if (positionMs > 0) {
        setLoadingOverlayStatus("Jumpgate lock acquired. Rendering first frames...");
        setLoadingOverlayProgress(Math.max(mOverlayProgress, 96));
      } else if (durationMs > 0) {
        setLoadingOverlayStatus("Manifest decoded. Priming video pipeline...");
      }
    });
  }

  /**
   * Called from native code when external player mode should exit. Sets the result intent with
   * VLC/MX Player compatible extras.
   *
   * @param generation exact native playback generation owning this result.
   * @param requestId exact result-owner activity request bound to {@code generation}.
   * @param wasStandalone if true, returns to standalone Kodi instead of killing the process. This
   *     is set when external player was launched from an already-running standalone Kodi instance
   *     (warm-transition via onNewIntent).
   */
  public synchronized void exitExternalPlayerMode(
      long generation,
      String requestId,
      long positionMs,
      long durationMs,
      boolean completed,
      boolean wasStandalone) {
    if (generation != mExternalResultProducer.activeGeneration()
        || !mExternalResultProducer.activeRequestId().equals(requestId)) {
      Log.d(TAG, "Main: Ignoring stale external player result generation " + generation);
      return;
    }

    ExternalPlayerResultCoordinator.TerminalReservation reservation =
        mExternalResultProducer.reserveFinish(
            generation, requestId, positionMs, durationMs, completed, !wasStandalone);
    if (reservation == null) {
      Log.d(TAG, "Main: Ignoring stale external player result generation " + generation);
      return;
    }

    ExternalPlayerResultCoordinator.Owner durableOwner =
        ExternalPlayerResultStore.readOwner(this, requestId);
    boolean ownerCanceled = mExternalResultProducer.isOwnerCanceled(generation, requestId);
    boolean callerAlreadyCanceled =
        ownerCanceled
            && durableOwner != null
            && durableOwner.expectedGeneration() == generation
            && durableOwner.wasCanceled();
    boolean canceledExitAcknowledged = false;
    boolean durable;
    if (callerAlreadyCanceled) {
      if (wasStandalone) {
        durable = ExternalPlayerResultStore.clear(this, requestId, generation);
      } else {
        canceledExitAcknowledged =
            ExternalPlayerResultStore.acknowledgeCanceledExit(this, requestId, generation);
        durable = canceledExitAcknowledged;
      }
    } else {
      durable = ExternalPlayerResultStore.publish(this, reservation.terminal());
    }
    if (!durable) {
      reservation.rollback();
      Log.e(TAG, "Main: Could not persist external player result " + generation);
      return;
    }
    if (!reservation.commit())
      throw new IllegalStateException("Exact external player terminal reservation changed");

    Log.d(
        TAG,
        "Main: Exiting external player mode. pos="
            + positionMs
            + " dur="
            + durationMs
            + " completed="
            + completed
            + " wasStandalone="
            + wasStandalone);

    if (wasStandalone) {
      // Warm-transition: return to standalone Kodi.
      // Do NOT finish Main (it stays alive as standalone Kodi).
      // Do NOT kill the process (native engine keeps running).
      boolean callerResultAcknowledged =
          mExternalResultProducer.isCallerResultAcknowledged(generation, requestId);
      mExternalPlayerMode = false;
      mExternalResultProducer.clear(generation, requestId);
      prepareWarmTaskHandoff(generation, requestId, callerResultAcknowledged);
      mWasStandalone = false;
      // Hide loading overlay so Kodi home screen is visible again
      hideLoadingOverlay();
      Log.d(TAG, "Main: Returning to standalone mode after external player");
    } else {
      // The result-owner activity acknowledges only after it has set its caller result and
      // requested finish. Until that exact acknowledgement, keep the process alive so recreation
      // can consume the durable terminal.
      mExternalPlayerMode = false;
      finishColdExternalPlayerTask();
      if (callerAlreadyCanceled && canceledExitAcknowledged)
        scheduleExternalPlayerProcessExit(generation, requestId);
    }
  }

  private synchronized void cancelPendingWarmTaskHandoff() {
    mWarmTaskHandoff.cancel();
  }

  private synchronized void prepareWarmTaskHandoff(
      long generation, String requestId, boolean callerResultAcknowledged) {
    mWarmTaskHandoff.prepare(
        mBackLifecycleToken, generation, requestId, callerResultAcknowledged);
  }

  private synchronized void scheduleWarmTaskHandoffIfReady(
      long lifecycleToken, long generation, String requestId) {
    mWarmTaskHandoff.scheduleIfReady(lifecycleToken, generation, requestId);
  }

  /** Called from native only after the exact warm return to standalone has fully completed. */
  public synchronized void handoffWarmExternalPlayerTask(
      long lifecycleToken, long generation, String requestId) {
    if (lifecycleToken == 0
        || lifecycleToken != mBackLifecycleToken
        || MainActivity != this
        || !mWarmTaskHandoff.markNativeReady(lifecycleToken, generation, requestId)) return;

    scheduleWarmTaskHandoffIfReady(lifecycleToken, generation, requestId);
  }

  public static boolean confirmWarmExternalPlayerResult(long generation, String requestId) {
    Main activity = MainActivity;
    return activity != null
        && activity.confirmWarmExternalPlayerResultInternal(generation, requestId);
  }

  private synchronized boolean confirmWarmExternalPlayerResultInternal(
      long generation, String requestId) {
    if (generation < 0 || !ExternalPlayerResultCoordinator.isValidRequestId(requestId)) return false;
    if (mWarmTaskHandoff.confirmCallerResult(generation, requestId)) {
      scheduleWarmTaskHandoffIfReady(mBackLifecycleToken, generation, requestId);
      return true;
    }
    if (generation == 0)
      return mExternalResultProducer.confirmCallerResult(generation, requestId);
    if (!mExternalPlayerMode || !mWasStandalone) return false;
    return mExternalResultProducer.confirmCallerResult(generation, requestId);
  }

  public static boolean acknowledgeExternalPlayerResult(long generation, String requestId) {
    Main activity = MainActivity;
    return activity != null
        && activity.acknowledgeExternalPlayerResultInternal(generation, requestId);
  }

  private synchronized boolean acknowledgeExternalPlayerResultInternal(
      long generation, String requestId) {
    if (mExternalPlayerMode || !mExternalResultProducer.acknowledgeExit(generation, requestId))
      return false;

    return scheduleExternalPlayerProcessExit(generation, requestId);
  }

  public static boolean cancelExternalPlayerResult(long generation, String requestId) {
    Main activity = MainActivity;
    return activity != null && activity.cancelExternalPlayerResultInternal(generation, requestId);
  }

  private synchronized boolean cancelExternalPlayerResultInternal(
      long generation, String requestId) {
    return mExternalResultProducer.cancelOwner(generation, requestId);
  }

  private boolean scheduleExternalPlayerProcessExit(long generation, String requestId) {
    if (!mExternalResultProducer.claimProcessExit(generation, requestId)) return false;

    final long acknowledgedGeneration = generation;
    final String acknowledgedRequestId = requestId;
    return handler.post(
        () -> {
          synchronized (Main.this) {
            if (!mExternalResultProducer.shouldExitProcess(
                    acknowledgedGeneration, acknowledgedRequestId)
                || mExternalPlayerMode) {
              Log.d(TAG, "Main: Skipping stale external player process exit");
              return;
            }
          }
          ExternalPlayerResultStore.executeAcknowledgedProcessExit(
              Main.this,
              acknowledgedRequestId,
              acknowledgedGeneration,
              () -> {
                Log.d(TAG, "Main: Killing process after acknowledged external player result");
                android.os.Process.killProcess(android.os.Process.myPid());
              });
        });
  }

  private void finishColdExternalPlayerTask() {
    runOnUiThread(
        () -> {
          if (mMainView != null) mMainView.setVisibility(View.INVISIBLE);
          if (mDecorView != null) mDecorView.setBackgroundColor(Color.BLACK);
          if (isTaskRoot()) finishAndRemoveTask();
          else finish();
        });
  }

  /** Called only after the native event loop and decoder teardown have completed. */
  public void markExternalPlayerCleanupReady(long generation, String requestId) {
    if (!ExternalPlayerResultStore.markProcessCleanupReady(this, requestId, generation)) return;
    scheduleAcknowledgedProcessExit(generation, requestId);
  }

  private void scheduleAcknowledgedProcessExit(long generation, String requestId) {
    final long exactGeneration = generation;
    final String exactRequestId = requestId;
    handler.post(
        () ->
            ExternalPlayerResultStore.executeAcknowledgedProcessExit(
                Main.this,
                exactRequestId,
                exactGeneration,
                () -> {
                  Log.d(TAG, "Main: Killing process after native cleanup and caller result");
                  android.os.Process.killProcess(android.os.Process.myPid());
                }));
  }

  /**
   * Mirrors the ordinary Android portal scene into a child SurfaceView. Kodi's GUI SurfaceView is
   * intentionally above the activity window so it can composite OSD over video; ordinary sibling
   * views therefore cannot cover it. This surface stays in the same activity/window while giving
   * the transition an explicit compositor layer above Kodi.
   */
  private final class LoadingPortalSurfaceView extends SurfaceView
      implements SurfaceHolder.Callback {
    private boolean mSurfaceReady = false;
    private boolean mRendering = false;
    private final Runnable mRenderFrame = new Runnable() {
      @Override
      public void run() {
        if (!mRendering || !mSurfaceReady || mLoadingPortalSurface != LoadingPortalSurfaceView.this)
          return;

        drawPortalFrame();
        handler.postDelayed(this, OVERLAY_SURFACE_FRAME_MS);
      }
    };

    LoadingPortalSurfaceView() {
      super(Main.this);
      setZOrderOnTop(true);
      setElevation(mMainView != null ? mMainView.getElevation() + 2f : 3f);
      getHolder().setFormat(PixelFormat.OPAQUE);
      getHolder().addCallback(this);
    }

    void startRendering() {
      if (mRendering)
        return;

      mRendering = true;
      handler.removeCallbacks(mRenderFrame);
      handler.post(mRenderFrame);
    }

    void stopRendering() {
      mRendering = false;
      handler.removeCallbacks(mRenderFrame);
    }

    private void drawPortalFrame() {
      final FrameLayout scene = mLoadingPortalScene;
      if (scene == null)
        return;

      Canvas canvas = null;
      try {
        canvas = Build.VERSION.SDK_INT >= VERSION_CODES.M
            ? getHolder().lockHardwareCanvas()
            : getHolder().lockCanvas();
        if (canvas == null)
          return;

        final int width = canvas.getWidth();
        final int height = canvas.getHeight();
        if (scene.getWidth() != width || scene.getHeight() != height) {
          final int widthSpec = View.MeasureSpec.makeMeasureSpec(width, View.MeasureSpec.EXACTLY);
          final int heightSpec = View.MeasureSpec.makeMeasureSpec(height, View.MeasureSpec.EXACTLY);
          scene.measure(widthSpec, heightSpec);
          scene.layout(0, 0, width, height);
        }
        canvas.drawColor(Color.BLACK);
        scene.draw(canvas);
      } catch (IllegalArgumentException | IllegalStateException error) {
        Log.w(TAG, "Main: Loading portal surface frame unavailable", error);
      } finally {
        if (canvas != null) {
          try {
            getHolder().unlockCanvasAndPost(canvas);
          } catch (IllegalArgumentException | IllegalStateException error) {
            Log.w(TAG, "Main: Loading portal surface frame could not be posted", error);
          }
        }
      }
    }

    @Override
    public void surfaceCreated(SurfaceHolder holder) {
      mSurfaceReady = true;
      if (!mPaused)
        startRendering();
    }

    @Override
    public void surfaceChanged(SurfaceHolder holder, int format, int width, int height) {
      if (mSurfaceReady)
        drawPortalFrame();
    }

    @Override
    public void surfaceDestroyed(SurfaceHolder holder) {
      mSurfaceReady = false;
      stopRendering();
    }
  }

  /**
   * Shows a Stremio-shaped Jumpgate transition above the SurfaceView.
   * The source claim supplies optional artwork after the black first frame is already visible.
   */
  private void showLoadingOverlay(Intent sourceIntent) {
    String requestId =
        sourceIntent == null
            ? ""
            : sourceIntent.getStringExtra(ExternalPlayerResultCoordinator.EXTRA_REQUEST_ID);
    mLoadingOverlayRequestId =
        ExternalPlayerResultCoordinator.isValidRequestId(requestId) ? requestId : "";
    if (mLoadingOverlay != null) {
      clearOverlayBackground();
      mOverlayLogoRequestId = nextOverlayArtworkRequestId();
      showOverlayLogoFallback(false);
      updateLoadingOverlayMetadata(sourceIntent);
      setLoadingOverlayStatus("Re-establishing selected stream...");
      setLoadingOverlayProgress(Math.max(mOverlayProgress, 12));
      return;
    }

    FrameLayout overlay = new FrameLayout(this);
    overlay.setElevation(mMainView != null ? mMainView.getElevation() + 1f : 2f);

    FrameLayout portalScene = new FrameLayout(this);
    portalScene.setBackgroundColor(Color.BLACK);
    overlay.addView(portalScene, new FrameLayout.LayoutParams(
        FrameLayout.LayoutParams.MATCH_PARENT, FrameLayout.LayoutParams.MATCH_PARENT));
    mLoadingPortalScene = portalScene;

    ImageView backdropView = new ImageView(this);
    backdropView.setScaleType(ImageView.ScaleType.CENTER_CROP);
    backdropView.setAlpha(0f);
    portalScene.addView(backdropView, new FrameLayout.LayoutParams(
        FrameLayout.LayoutParams.MATCH_PARENT, FrameLayout.LayoutParams.MATCH_PARENT));
    mOverlayBackdropView = backdropView;

    FrameLayout portalIndicator = new FrameLayout(this);
    GradientDrawable indicatorBackground = new GradientDrawable();
    indicatorBackground.setShape(GradientDrawable.RECTANGLE);
    indicatorBackground.setCornerRadius(dp(7));
    indicatorBackground.setColor(Color.parseColor("#A30A1117"));
    indicatorBackground.setStroke(dp(1), Color.parseColor("#667EDDF5"));
    portalIndicator.setBackground(indicatorBackground);
    FrameLayout.LayoutParams indicatorParams = new FrameLayout.LayoutParams(dp(248), dp(46));
    indicatorParams.gravity = Gravity.TOP | Gravity.CENTER_HORIZONTAL;
    indicatorParams.topMargin = dp(24);
    portalScene.addView(portalIndicator, indicatorParams);

    TextView indicatorLabel = new TextView(this);
    indicatorLabel.setText("JUMPGATE LOADING");
    indicatorLabel.setTextColor(Color.parseColor("#DDF5FC"));
    indicatorLabel.setTextSize(TypedValue.COMPLEX_UNIT_SP, 10);
    indicatorLabel.setLetterSpacing(0.22f);
    indicatorLabel.setGravity(Gravity.CENTER);
    FrameLayout.LayoutParams indicatorLabelParams = new FrameLayout.LayoutParams(
        FrameLayout.LayoutParams.MATCH_PARENT, dp(30));
    indicatorLabelParams.gravity = Gravity.TOP;
    portalIndicator.addView(indicatorLabel, indicatorLabelParams);

    FrameLayout progressTrack = new FrameLayout(this);
    GradientDrawable progressTrackDrawable = new GradientDrawable();
    progressTrackDrawable.setShape(GradientDrawable.RECTANGLE);
    progressTrackDrawable.setCornerRadius(dp(1));
    progressTrackDrawable.setColor(Color.parseColor("#30476170"));
    progressTrack.setBackground(progressTrackDrawable);
    FrameLayout.LayoutParams progressTrackParams = new FrameLayout.LayoutParams(dp(204), dp(2));
    progressTrackParams.gravity = Gravity.BOTTOM | Gravity.CENTER_HORIZONTAL;
    progressTrackParams.bottomMargin = dp(8);
    portalIndicator.addView(progressTrack, progressTrackParams);

    View progressFill = new View(this);
    GradientDrawable progressFillDrawable = new GradientDrawable(
        GradientDrawable.Orientation.LEFT_RIGHT,
        new int[] {
            Color.parseColor("#9CEBFF"),
            Color.parseColor("#24B9E8"),
            Color.parseColor("#056C97")
        });
    progressFillDrawable.setCornerRadius(dp(1));
    progressFill.setBackground(progressFillDrawable);
    progressTrack.addView(progressFill, new FrameLayout.LayoutParams(
        FrameLayout.LayoutParams.MATCH_PARENT, FrameLayout.LayoutParams.MATCH_PARENT));
    progressFill.setPivotX(0f);
    progressFill.setScaleX(0f);
    mOverlayProgressFill = progressFill;

    FrameLayout pulseContainer = new FrameLayout(this);
    FrameLayout.LayoutParams pulseParams = new FrameLayout.LayoutParams(dp(200), dp(80));
    pulseParams.gravity = Gravity.CENTER;
    portalScene.addView(pulseContainer, pulseParams);
    mOverlayLogoPulseContainer = pulseContainer;

    ImageView logoView = new ImageView(this);
    logoView.setAdjustViewBounds(true);
    logoView.setScaleType(ImageView.ScaleType.FIT_CENTER);
    logoView.setImageResource(R.drawable.jumpgate_wordmark);
    pulseContainer.addView(logoView, new FrameLayout.LayoutParams(
        FrameLayout.LayoutParams.MATCH_PARENT, FrameLayout.LayoutParams.MATCH_PARENT));
    mOverlayLogoView = logoView;

    LinearLayout details = new LinearLayout(this);
    details.setOrientation(LinearLayout.VERTICAL);
    details.setGravity(Gravity.CENTER_HORIZONTAL);
    FrameLayout.LayoutParams detailsParams = new FrameLayout.LayoutParams(
        FrameLayout.LayoutParams.MATCH_PARENT, FrameLayout.LayoutParams.WRAP_CONTENT);
    detailsParams.gravity = Gravity.CENTER;
    detailsParams.leftMargin = dp(32);
    detailsParams.rightMargin = dp(32);
    details.setTranslationY(dp(104));
    portalScene.addView(details, detailsParams);

    TextView title = new TextView(this);
    title.setTextColor(Color.WHITE);
    title.setTextSize(TypedValue.COMPLEX_UNIT_SP, 16);
    title.setTypeface(title.getTypeface(), android.graphics.Typeface.BOLD);
    title.setGravity(Gravity.CENTER);
    title.setMaxLines(2);
    title.setEllipsize(TextUtils.TruncateAt.END);
    details.addView(title, new LinearLayout.LayoutParams(
        LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT));
    mOverlayTitleText = title;

    TextView meta = new TextView(this);
    meta.setTextColor(Color.parseColor("#BDD9E5"));
    meta.setTextSize(TypedValue.COMPLEX_UNIT_SP, 11);
    meta.setGravity(Gravity.CENTER);
    meta.setAllCaps(true);
    LinearLayout.LayoutParams metaParams = new LinearLayout.LayoutParams(
        LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT);
    metaParams.topMargin = dp(5);
    details.addView(meta, metaParams);
    mOverlayMetaText = meta;

    TextView status = new TextView(this);
    status.setTextColor(Color.parseColor("#A8C7D4"));
    status.setTextSize(TypedValue.COMPLEX_UNIT_SP, 11);
    status.setGravity(Gravity.CENTER);
    status.setMaxLines(1);
    status.setEllipsize(TextUtils.TruncateAt.END);
    LinearLayout.LayoutParams statusParams = new LinearLayout.LayoutParams(
        LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT);
    statusParams.topMargin = dp(10);
    details.addView(status, statusParams);
    mOverlayStatusText = status;

    updateLoadingOverlayMetadata(sourceIntent);
    setLoadingOverlayStatus("Opening selected stream...");
    setLoadingOverlayProgress(8);

    LoadingPortalSurfaceView portalSurface = new LoadingPortalSurfaceView();
    overlay.addView(portalSurface, new FrameLayout.LayoutParams(
        FrameLayout.LayoutParams.MATCH_PARENT, FrameLayout.LayoutParams.MATCH_PARENT));
    portalSurface.bringToFront();
    mLoadingPortalSurface = portalSurface;

    ViewGroup contentRoot = findViewById(android.R.id.content);
    if (contentRoot == null) {
      Log.e(TAG, "Main: Cannot show loading portal without an activity content root");
      clearLoadingOverlayReferences();
      return;
    }
    contentRoot.addView(
        overlay,
        new ViewGroup.LayoutParams(
            ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
    overlay.bringToFront();
    mLoadingOverlay = overlay;
    mOverlayShownAtMs = System.currentTimeMillis();
    Log.d(TAG, "Main: Jumpgate loading portal shown");

    overlay.post(this::resumeLoadingOverlayAnimations);
  }

  /** Called from native code once synchronized A/V playback is ready to reveal. */
  public void hideLoadingOverlay() {
    runOnUiThread(() -> {
      pauseLoadingOverlayAnimations();
      final View overlay = mLoadingOverlay;
      final LoadingPortalSurfaceView portalSurface = mLoadingPortalSurface;
      clearLoadingOverlayReferences();

      if (overlay != null) {
        overlay.animate().cancel();
        if (portalSurface != null) {
          portalSurface.animate().cancel();
          portalSurface.animate().alpha(0f).setDuration(140L).start();
        }
        overlay.animate().alpha(0f).setDuration(140L).withEndAction(() -> {
          ViewParent parent = overlay.getParent();
          if (parent instanceof ViewGroup)
            ((ViewGroup) parent).removeView(overlay);
        }).start();
        Log.d(TAG, "Main: Loading portal fading into playback");
      }
    });
  }

  private void hideLoadingOverlayForRequest(String requestId) {
    runOnUiThread(() -> {
      if (!ExternalPlayerResultCoordinator.isValidRequestId(requestId)
          || !requestId.equals(mLoadingOverlayRequestId)) {
        Log.d(TAG, "Main: Ignoring stale loading portal dismissal " + requestId);
        return;
      }
      hideLoadingOverlay();
    });
  }

  private void clearLoadingOverlayReferences() {
    mLoadingOverlay = null;
    mLoadingPortalScene = null;
    mLoadingPortalSurface = null;
    mLoadingOverlayRequestId = "";
    mOverlayLogoRequestId = nextOverlayArtworkRequestId();
    mOverlayBackgroundRequestId = nextOverlayArtworkRequestId();
    mOverlayBackdropView = null;
    mOverlayLogoPulseContainer = null;
    mOverlayProgressFill = null;
    mOverlayStatusText = null;
    mOverlayTitleText = null;
    mOverlayMetaText = null;
    mOverlayLogoView = null;
    mOverlayLogoUrl = "";
    mOverlayBackgroundUrl = "";
    mOverlayProgress = 0;
  }

  private void detachLoadingOverlayImmediately() {
    pauseLoadingOverlayAnimations();
    final View overlay = mLoadingOverlay;
    final LoadingPortalSurfaceView portalSurface = mLoadingPortalSurface;
    clearLoadingOverlayReferences();
    if (overlay == null)
      return;

    overlay.animate().cancel();
    if (portalSurface != null)
      portalSurface.animate().cancel();
    ViewParent parent = overlay.getParent();
    if (parent instanceof ViewGroup)
      ((ViewGroup) parent).removeView(overlay);
  }

  private void resumeLoadingOverlayAnimations() {
    if (mLoadingOverlay == null || mPaused || !mLoadingOverlay.isAttachedToWindow())
      return;

    if (mLoadingPortalSurface != null)
      mLoadingPortalSurface.startRendering();
    startLoadingOverlayAnimations();
    startLoadingOverlayProgressTicker();
  }

  private void pauseLoadingOverlayAnimations() {
    if (mLoadingPortalSurface != null)
      mLoadingPortalSurface.stopRendering();
    if (mOverlayProgressRunnable != null) {
      handler.removeCallbacks(mOverlayProgressRunnable);
      mOverlayProgressRunnable = null;
    }

    if (mOverlayPulseAnimator != null) {
      mOverlayPulseAnimator.cancel();
      mOverlayPulseAnimator = null;
    }
  }

  private void startLoadingOverlayAnimations() {
    if (mOverlayLogoPulseContainer == null || mOverlayPulseAnimator != null) {
      return;
    }

    mOverlayPulseAnimator = ValueAnimator.ofFloat(0f, 1f);
    mOverlayPulseAnimator.setDuration(750L);
    mOverlayPulseAnimator.setRepeatMode(ValueAnimator.REVERSE);
    mOverlayPulseAnimator.setRepeatCount(ValueAnimator.INFINITE);
    mOverlayPulseAnimator.addUpdateListener(animator -> {
      if (mOverlayLogoPulseContainer == null) {
        return;
      }
      float phase = (float) animator.getAnimatedValue();
      float scale = 1f + (0.05f * phase);
      mOverlayLogoPulseContainer.setScaleX(scale);
      mOverlayLogoPulseContainer.setScaleY(scale);
      mOverlayLogoPulseContainer.setAlpha(0.20f + (0.80f * phase));
    });
    mOverlayPulseAnimator.start();
  }

  private void startLoadingOverlayProgressTicker() {
    if (mOverlayProgressRunnable != null) {
      handler.removeCallbacks(mOverlayProgressRunnable);
    }

    mOverlayProgressRunnable = new Runnable() {
      @Override
      public void run() {
        if (mLoadingOverlay == null) {
          return;
        }

        long elapsedMs = System.currentTimeMillis() - mOverlayShownAtMs;
        int targetProgress;
        String status;

        if (elapsedMs < 1200L) {
          targetProgress = 14;
          status = "Opening selected stream...";
        } else if (elapsedMs < 2600L) {
          targetProgress = 30;
          status = "Claiming source context...";
        } else if (elapsedMs < 4500L) {
          targetProgress = 48;
          status = "Preparing title and subtitles...";
        } else if (elapsedMs < 7000L) {
          targetProgress = 66;
          status = "Opening Kodi media pipeline...";
        } else if (elapsedMs < 10000L) {
          targetProgress = 78;
          status = "Buffering video...";
        } else if (elapsedMs < 15000L) {
          targetProgress = 87;
          status = "Synchronizing audio and video...";
        } else {
          targetProgress = 92;
          status = "Waiting for the first frame...";
        }

        if (mLastPlaybackDuration > 0) {
          targetProgress = Math.max(targetProgress, 88);
          status = "Video pipeline ready...";
        }
        if (mLastPlaybackPosition > 0) {
          targetProgress = Math.max(targetProgress, 96);
          status = "Rendering first frame...";
        }

        setLoadingOverlayStatus(status);
        if (targetProgress > mOverlayProgress) {
          setLoadingOverlayProgress(Math.min(97, targetProgress));
        }

        handler.postDelayed(this, 300L);
      }
    };

    handler.post(mOverlayProgressRunnable);
  }

  private void setLoadingOverlayStatus(String status) {
    if (mOverlayStatusText != null) {
      mOverlayStatusText.setText(status);
    }
  }

  private void setLoadingOverlayProgress(int progress) {
    int safeProgress = Math.max(0, Math.min(progress, 100));
    mOverlayProgress = safeProgress;
    if (mOverlayProgressFill != null) {
      mOverlayProgressFill.setScaleX(safeProgress / 100f);
    }
  }

  private void updateLoadingOverlayMetadata(Intent intent) {
    if (mOverlayTitleText != null) {
      String derivedTitle = deriveOverlayTitle(intent);
      mOverlayTitleText.setText(derivedTitle);
      Log.d(TAG, "Main: Jumpgate overlay title: " + derivedTitle);
    }
    if (mOverlayMetaText != null) {
      mOverlayMetaText.setText(deriveOverlayMeta(intent));
    }
  }

  private String deriveOverlayTitle(Intent intent) {
    String title = getExtraString(intent, "_mk_title");
    if (TextUtils.isEmpty(title)) {
      title = getExtraString(intent, Intent.EXTRA_TITLE);
    }
    if (TextUtils.isEmpty(title)) {
      title = getExtraString(intent, "title");
    }
    if (TextUtils.isEmpty(title)) {
      String uriTitle = extractTitleFromUri(intent != null ? intent.getData() : null);
      if (!TextUtils.isEmpty(uriTitle) && !isLikelyLowConfidenceUriTitle(uriTitle)) {
        title = uriTitle;
      }
    }

    if (!TextUtils.isEmpty(title) && isLikelyOpaqueTokenTitle(title)) {
      title = "";
    }
    return TextUtils.isEmpty(title) ? "Identifying..." : title;
  }

  /** Called from native code when the authenticated source claim improves display metadata. */
  public void updateLoadingOverlayContentInfo(final String title, final String meta,
                                              final String logoUrl,
                                              final String backgroundUrl) {
    if (mLoadingOverlay == null) {
      return;
    }

    runOnUiThread(() -> {
      if (mLoadingOverlay == null) {
        return;
      }

      String safeTitle = title != null ? title.trim() : "";
      if (TextUtils.isEmpty(safeTitle) || isLikelyOpaqueTokenTitle(safeTitle)) {
        safeTitle = "Identifying...";
      }
      if (mOverlayTitleText != null) {
        mOverlayTitleText.setText(safeTitle);
        mOverlayTitleText.setVisibility(View.VISIBLE);
      }

      String safeMeta = meta != null ? meta.trim() : "";
      if (!TextUtils.isEmpty(safeMeta) && !isLikelyOpaqueTokenTitle(safeMeta)
          && mOverlayMetaText != null) {
        mOverlayMetaText.setText(safeMeta);
      }

      loadOverlayBackground(backgroundUrl);
      loadOverlayLogo(logoUrl, isEpisodeMeta(safeMeta));
    });
  }

  private boolean isEpisodeMeta(String meta) {
    return !TextUtils.isEmpty(meta) && meta.matches("(?i).*\\bS\\d{1,2}E\\d{1,2}\\b.*");
  }

  private boolean isAllowedArtworkUrl(String rawUrl) {
    if (TextUtils.isEmpty(rawUrl)) {
      return false;
    }
    try {
      Uri uri = Uri.parse(rawUrl);
      String path = uri.getEncodedPath();
      return uri.isHierarchical()
          && "https".equalsIgnoreCase(uri.getScheme())
          && "image.tmdb.org".equalsIgnoreCase(uri.getHost())
          && uri.getPort() == -1
          && uri.getEncodedUserInfo() == null
          && uri.getQuery() == null
          && uri.getFragment() == null
          && path != null
          && path.startsWith("/t/p/");
    } catch (Exception _e) {
      return false;
    }
  }

  private long nextOverlayArtworkRequestId() {
    if (mOverlayArtworkSequence == Long.MAX_VALUE) {
      mOverlayArtworkSequence = 1L;
    } else {
      mOverlayArtworkSequence++;
    }
    return mOverlayArtworkSequence;
  }

  private void showOverlayLogoFallback(boolean isEpisode) {
    if (mOverlayLogoView != null) {
      mOverlayLogoView.setImageResource(R.drawable.jumpgate_wordmark);
      mOverlayLogoView.setVisibility(View.VISIBLE);
    }
    mOverlayLogoUrl = "";
    if (!isEpisode && mOverlayTitleText != null) {
      mOverlayTitleText.setVisibility(View.VISIBLE);
    }
  }

  private String hashOverlayArtworkUrl(String rawUrl) {
    try {
      MessageDigest md = MessageDigest.getInstance("SHA-256");
      byte[] digest = md.digest(rawUrl.getBytes("UTF-8"));
      StringBuilder out = new StringBuilder(digest.length * 2);
      for (byte b : digest) {
        out.append(String.format(Locale.US, "%02x", b));
      }
      return out.toString();
    } catch (Exception _e) {
      return Integer.toHexString(rawUrl.hashCode());
    }
  }

  private File getOverlayArtworkCacheDir() {
    try {
      // Keep the existing directory so prior bounded logo entries are pruned with new backdrops.
      File dir = new File(getCacheDir(), "jumpgate_logo_cache");
      if (!dir.exists() && !dir.mkdirs()) {
        return null;
      }
      return dir;
    } catch (Exception _e) {
      return null;
    }
  }

  private File getOverlayArtworkDiskFile(String rawUrl) {
    File dir = getOverlayArtworkCacheDir();
    return dir == null ? null : new File(dir, hashOverlayArtworkUrl(rawUrl) + ".png");
  }

  private byte[] readOverlayArtworkBytes(InputStream input, int maximumBytes) throws Exception {
    ByteArrayOutputStream output = new ByteArrayOutputStream(Math.min(maximumBytes, 64 * 1024));
    byte[] buffer = new byte[16 * 1024];
    int total = 0;
    int count;
    while ((count = input.read(buffer)) != -1) {
      total += count;
      if (total > maximumBytes) {
        return null;
      }
      output.write(buffer, 0, count);
    }
    return output.toByteArray();
  }

  private Bitmap decodeOverlayArtwork(byte[] encoded, boolean preserveAlpha) {
    if (encoded == null || encoded.length == 0
        || encoded.length > OVERLAY_ARTWORK_MAX_ENCODED_BYTES) {
      return null;
    }

    BitmapFactory.Options bounds = new BitmapFactory.Options();
    bounds.inJustDecodeBounds = true;
    BitmapFactory.decodeByteArray(encoded, 0, encoded.length, bounds);
    if (bounds.outWidth <= 0 || bounds.outHeight <= 0
        || bounds.outWidth > OVERLAY_ARTWORK_MAX_DIMENSION
        || bounds.outHeight > OVERLAY_ARTWORK_MAX_DIMENSION
        || ((long) bounds.outWidth * (long) bounds.outHeight) > OVERLAY_ARTWORK_MAX_PIXELS) {
      return null;
    }

    int targetDimension = preserveAlpha ? 1024 : 1920;
    int sampleSize = 1;
    while ((bounds.outWidth / sampleSize) > targetDimension
        || (bounds.outHeight / sampleSize) > targetDimension) {
      sampleSize *= 2;
    }

    BitmapFactory.Options options = new BitmapFactory.Options();
    options.inSampleSize = sampleSize;
    options.inPreferredConfig = preserveAlpha ? Bitmap.Config.ARGB_8888 : Bitmap.Config.RGB_565;
    return BitmapFactory.decodeByteArray(encoded, 0, encoded.length, options);
  }

  private Bitmap loadOverlayArtworkFromDisk(String rawUrl, boolean preserveAlpha) {
    File cacheFile = getOverlayArtworkDiskFile(rawUrl);
    if (cacheFile == null || !cacheFile.isFile()) {
      return null;
    }

    long now = System.currentTimeMillis();
    if ((now - cacheFile.lastModified()) > OVERLAY_ARTWORK_DISK_MAX_AGE_MS
        || cacheFile.length() <= 0
        || cacheFile.length() > OVERLAY_ARTWORK_MAX_ENCODED_BYTES) {
      cacheFile.delete();
      return null;
    }

    try (FileInputStream input = new FileInputStream(cacheFile)) {
      byte[] encoded = readOverlayArtworkBytes(input, OVERLAY_ARTWORK_MAX_ENCODED_BYTES);
      Bitmap bitmap = decodeOverlayArtwork(encoded, preserveAlpha);
      if (bitmap == null) {
        cacheFile.delete();
        return null;
      }
      cacheFile.setLastModified(now);
      return bitmap;
    } catch (Exception _e) {
      return null;
    }
  }

  private void pruneOverlayArtworkDiskCache(File dir) {
    if (dir == null) {
      return;
    }
    File[] files = dir.listFiles();
    if (files == null || files.length == 0) {
      return;
    }

    final long now = System.currentTimeMillis();
    long totalBytes = 0L;
    int count = 0;
    for (File file : files) {
      if (file == null || !file.isFile()) {
        continue;
      }
      if ((now - file.lastModified()) > OVERLAY_ARTWORK_DISK_MAX_AGE_MS) {
        file.delete();
        continue;
      }
      totalBytes += Math.max(0L, file.length());
      count++;
    }

    if (count <= OVERLAY_ARTWORK_DISK_MAX_FILES
        && totalBytes <= OVERLAY_ARTWORK_DISK_MAX_BYTES) {
      return;
    }

    files = dir.listFiles();
    if (files == null) {
      return;
    }
    Arrays.sort(files, (a, b) -> Long.compare(a.lastModified(), b.lastModified()));
    for (File file : files) {
      if (file == null || !file.isFile()) {
        continue;
      }
      if (count <= OVERLAY_ARTWORK_DISK_MAX_FILES
          && totalBytes <= OVERLAY_ARTWORK_DISK_MAX_BYTES) {
        break;
      }
      long length = Math.max(0L, file.length());
      if (file.delete()) {
        count--;
        totalBytes = Math.max(0L, totalBytes - length);
      }
    }
  }

  private void saveOverlayArtworkToDisk(String rawUrl, byte[] encoded) {
    if (encoded == null || encoded.length == 0
        || encoded.length > OVERLAY_ARTWORK_MAX_ENCODED_BYTES) {
      return;
    }
    File cacheFile = getOverlayArtworkDiskFile(rawUrl);
    if (cacheFile == null || cacheFile.getParentFile() == null) {
      return;
    }

    File temp = new File(cacheFile.getAbsolutePath() + ".tmp");
    try {
      try (FileOutputStream output = new FileOutputStream(temp, false)) {
        output.write(encoded);
        output.flush();
      }
      if (cacheFile.exists() && !cacheFile.delete()) {
        return;
      }
      if (!temp.renameTo(cacheFile)) {
        return;
      }
      cacheFile.setLastModified(System.currentTimeMillis());
      pruneOverlayArtworkDiskCache(cacheFile.getParentFile());
    } catch (Exception _e) {
      // Artwork remains optional; a cache write must never block playback.
    } finally {
      if (temp.exists() && !temp.equals(cacheFile)) {
        temp.delete();
      }
    }
  }

  private byte[] downloadOverlayArtwork(String rawUrl) {
    String currentUrl = rawUrl;
    for (int redirectCount = 0; redirectCount <= OVERLAY_ARTWORK_MAX_REDIRECTS;
         redirectCount++) {
      if (!isAllowedArtworkUrl(currentUrl)) {
        return null;
      }

      HttpURLConnection connection = null;
      InputStream input = null;
      try {
        URL parsedUrl = new URL(currentUrl);
        connection = (HttpURLConnection) parsedUrl.openConnection();
        connection.setConnectTimeout(2000);
        connection.setReadTimeout(3000);
        connection.setInstanceFollowRedirects(false);
        connection.setUseCaches(true);
        connection.setRequestProperty("User-Agent", "Jumpgate");
        connection.setRequestProperty("Accept", "image/webp,image/*,*/*;q=0.8");

        int status = connection.getResponseCode();
        if (status >= 300 && status < 400) {
          String location = connection.getHeaderField("Location");
          if (TextUtils.isEmpty(location) || redirectCount == OVERLAY_ARTWORK_MAX_REDIRECTS) {
            return null;
          }
          currentUrl = new URL(parsedUrl, location).toString();
          continue;
        }
        if (status != HttpURLConnection.HTTP_OK) {
          return null;
        }

        int contentLength = connection.getContentLength();
        if (contentLength > OVERLAY_ARTWORK_MAX_ENCODED_BYTES) {
          return null;
        }
        String contentType = connection.getContentType();
        if (contentType == null || !contentType.toLowerCase(Locale.US).startsWith("image/")) {
          return null;
        }

        input = connection.getInputStream();
        return readOverlayArtworkBytes(input, OVERLAY_ARTWORK_MAX_ENCODED_BYTES);
      } catch (Exception _e) {
        return null;
      } finally {
        try {
          if (input != null) input.close();
        } catch (Exception _e) {}
        if (connection != null) connection.disconnect();
      }
    }
    return null;
  }

  private void showOverlayBackgroundBitmap(Bitmap bitmap) {
    if (mOverlayBackdropView == null || bitmap == null || bitmap.isRecycled()) {
      return;
    }
    mOverlayBackdropView.animate().cancel();
    mOverlayBackdropView.setImageBitmap(bitmap);
    mOverlayBackdropView.setAlpha(0f);
    mOverlayBackdropView.animate().alpha(0.50f).setDuration(220L).start();
  }

  private void clearOverlayBackground() {
    mOverlayBackgroundRequestId = nextOverlayArtworkRequestId();
    mOverlayBackgroundUrl = "";
    if (mOverlayBackdropView != null) {
      mOverlayBackdropView.animate().cancel();
      mOverlayBackdropView.setImageDrawable(null);
      mOverlayBackdropView.setAlpha(0f);
    }
  }

  private void loadOverlayBackground(String rawUrl) {
    if (mOverlayBackdropView == null) {
      return;
    }
    String url = rawUrl != null ? rawUrl.trim() : "";
    if (TextUtils.isEmpty(url) || !isAllowedArtworkUrl(url)) {
      clearOverlayBackground();
      return;
    }
    if (url.equals(mOverlayBackgroundUrl)) {
      return;
    }

    final long requestId = nextOverlayArtworkRequestId();
    mOverlayBackgroundRequestId = requestId;
    mOverlayBackgroundUrl = url;
    mOverlayBackdropView.animate().cancel();
    mOverlayBackdropView.setImageDrawable(null);
    mOverlayBackdropView.setAlpha(0f);
    Bitmap memoryBitmap = sOverlayArtworkCache.get(url);
    if (memoryBitmap != null && !memoryBitmap.isRecycled()) {
      showOverlayBackgroundBitmap(memoryBitmap);
      return;
    }

    new Thread(() -> {
      Bitmap bitmap = loadOverlayArtworkFromDisk(url, false);
      byte[] downloaded = null;
      if (bitmap == null) {
        downloaded = downloadOverlayArtwork(url);
        bitmap = decodeOverlayArtwork(downloaded, false);
      }
      final Bitmap loadedBitmap = bitmap;
      final byte[] encoded = downloaded;
      runOnUiThread(() -> {
        if (mLoadingOverlay == null || requestId != mOverlayBackgroundRequestId
            || mOverlayBackdropView == null) {
          return;
        }
        if (loadedBitmap == null) {
          clearOverlayBackground();
          return;
        }
        sOverlayArtworkCache.put(url, loadedBitmap);
        showOverlayBackgroundBitmap(loadedBitmap);
      });
      if (loadedBitmap != null && encoded != null) {
        saveOverlayArtworkToDisk(url, encoded);
      }
    }, "Jumpgate-backdrop").start();
  }

  private void loadOverlayLogo(String rawUrl, boolean isEpisode) {
    if (mOverlayLogoView == null) {
      return;
    }
    String url = rawUrl != null ? rawUrl.trim() : "";
    if (TextUtils.isEmpty(url) || !isAllowedArtworkUrl(url)) {
      mOverlayLogoRequestId = nextOverlayArtworkRequestId();
      showOverlayLogoFallback(isEpisode);
      return;
    }
    if (url.equals(mOverlayLogoUrl)) {
      return;
    }

    final long requestId = nextOverlayArtworkRequestId();
    mOverlayLogoRequestId = requestId;
    showOverlayLogoFallback(isEpisode);
    mOverlayLogoUrl = url;
    Bitmap memoryBitmap = sOverlayArtworkCache.get(url);
    if (memoryBitmap != null && !memoryBitmap.isRecycled()) {
      mOverlayLogoView.setImageBitmap(memoryBitmap);
      mOverlayLogoView.setVisibility(View.VISIBLE);
      if (!isEpisode && mOverlayTitleText != null) {
        mOverlayTitleText.setVisibility(View.GONE);
      }
      return;
    }

    new Thread(() -> {
      Bitmap bitmap = loadOverlayArtworkFromDisk(url, true);
      byte[] downloaded = null;
      if (bitmap == null) {
        downloaded = downloadOverlayArtwork(url);
        bitmap = decodeOverlayArtwork(downloaded, true);
      }
      final Bitmap loadedBitmap = bitmap;
      final byte[] encoded = downloaded;
      runOnUiThread(() -> {
        if (mLoadingOverlay == null || requestId != mOverlayLogoRequestId
            || mOverlayLogoView == null) {
          return;
        }
        if (loadedBitmap == null) {
          showOverlayLogoFallback(isEpisode);
          return;
        }
        sOverlayArtworkCache.put(url, loadedBitmap);
        mOverlayLogoView.setImageBitmap(loadedBitmap);
        mOverlayLogoView.setVisibility(View.VISIBLE);
        if (!isEpisode && mOverlayTitleText != null) {
          mOverlayTitleText.setVisibility(View.GONE);
        }
      });
      if (loadedBitmap != null && encoded != null) {
        saveOverlayArtworkToDisk(url, encoded);
      }
    }, "Jumpgate-logo").start();
  }

  private String deriveOverlayMeta(Intent intent) {
    int season = intent != null ? intent.getIntExtra("_mk_s", -1) : -1;
    int episode = intent != null ? intent.getIntExtra("_mk_e", -1) : -1;

    StringBuilder meta = new StringBuilder();
    if (season > 0 && episode > 0) {
      meta.append(String.format(Locale.US, "S%02dE%02d", season, episode));
    }

    String quality = extractQualityHint(deriveOverlayTitle(intent));
    if (!TextUtils.isEmpty(quality)) {
      if (meta.length() > 0) {
        meta.append("  -  ");
      }
      meta.append(quality);
    }

    if (meta.length() > 0) {
      meta.append("  -  ");
    }
    meta.append("EXTERNAL STREAM");

    return meta.toString();
  }

  private String getExtraString(Intent intent, String key) {
    if (intent == null || TextUtils.isEmpty(key) || intent.getExtras() == null) {
      return "";
    }

    String value = intent.getExtras().getString(key, "");
    return value != null ? value.trim() : "";
  }

  private String extractTitleFromUri(Uri uri) {
    if (uri == null) {
      return "";
    }

    // Best-case query hints from some proxies/debrid endpoints.
    String[] candidateParams =
        new String[] {"_mk_title", "title", "filename", "file", "name", "dn"};
    try {
      for (String key : candidateParams) {
        String value = uri.getQueryParameter(key);
        String cleaned = sanitizeTitleCandidate(value);
        if (!TextUtils.isEmpty(cleaned)) {
          return cleaned;
        }
      }
    } catch (UnsupportedOperationException e) {
      // Opaque URIs don't support query parameters. Fall through to path parsing.
    } catch (Exception e) {
      // Defensive: title extraction must never crash the player.
      Log.w(TAG, "Main: Failed to extract title from URI query params", e);
    }

    // debridmediamanager.com URLs are frequently opaque token paths; avoid displaying those.
    String host = uri.getHost();
    if (!TextUtils.isEmpty(host) && host.toLowerCase(Locale.US).contains("debridmediamanager")) {
      return "";
    }

    String bestCandidate = "";
    int bestScore = -1;
    String path = uri.getPath();
    if (!TextUtils.isEmpty(path)) {
      String[] segments = path.split("/");
      for (String segment : segments) {
        String candidate = sanitizeTitleCandidate(segment);
        int score = scoreTitleCandidate(candidate);
        if (score > bestScore) {
          bestScore = score;
          bestCandidate = candidate;
        }
      }
    }

    if (!TextUtils.isEmpty(bestCandidate)) {
      return bestCandidate;
    }

    return sanitizeTitleCandidate(uri.toString());
  }

  private int scoreTitleCandidate(String candidate) {
    if (TextUtils.isEmpty(candidate)) {
      return -1;
    }

    int letters = 0;
    for (int i = 0; i < candidate.length(); i++) {
      if (Character.isLetter(candidate.charAt(i))) {
        letters++;
      }
    }

    // Strongly prefer human-readable title-like strings.
    int score = letters + (candidate.contains(" ") ? 6 : 0) - Math.max(0, candidate.length() - 64);
    if (candidate.equalsIgnoreCase("jumpgate stream")) {
      score -= 100;
    }
    return score;
  }

  private String sanitizeTitleCandidate(String rawCandidate) {
    if (TextUtils.isEmpty(rawCandidate)) {
      return "";
    }

    // Fast reject common token-like inputs (UUIDs, long opaque ids).
    String raw = rawCandidate.trim();
    if (raw.matches("(?i)^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$")) {
      return "";
    }
    if (raw.length() >= 28 && raw.matches("^[A-Za-z0-9_-]+$") && !raw.contains(".")) {
      return "";
    }

    String decoded;
    try {
      decoded = Uri.decode(rawCandidate);
    } catch (Exception e) {
      decoded = rawCandidate;
    }
    int queryIdx = decoded.indexOf('?');
    if (queryIdx >= 0) {
      decoded = decoded.substring(0, queryIdx);
    }
    int hashIdx = decoded.indexOf('#');
    if (hashIdx >= 0) {
      decoded = decoded.substring(0, hashIdx);
    }
    int slashIdx = decoded.lastIndexOf('/');
    if (slashIdx >= 0 && slashIdx + 1 < decoded.length()) {
      decoded = decoded.substring(slashIdx + 1);
    }

    if (decoded.toLowerCase(Locale.US).startsWith("_token_")) {
      return "";
    }

    decoded = decoded.replaceAll("(?i)\\.(mkv|mp4|avi|mov|wmv|webm|ts|m3u8|mpd)$", "");
    decoded = decoded.replaceAll("\\[[^\\]]*\\]|\\([^\\)]*\\)|\\{[^\\}]*\\}", " ");
    decoded = decoded.replaceAll("[._]+", " ");
    decoded = decoded.replaceAll("\\s+", " ").trim();

    if (TextUtils.isEmpty(decoded)) {
      return "";
    }

    Matcher yearMatch = Pattern.compile("\\b(19|20)\\d{2}\\b").matcher(decoded);
    if (yearMatch.find() && yearMatch.start() > 2) {
      decoded = decoded.substring(0, yearMatch.start()).trim();
    }

    Matcher seasonEpisodeMatch = Pattern.compile("(?i)\\bS\\d{1,2}E\\d{1,2}\\b").matcher(decoded);
    if (seasonEpisodeMatch.find() && seasonEpisodeMatch.start() > 2) {
      decoded = decoded.substring(0, seasonEpisodeMatch.start()).trim();
    }

    String[] parts = decoded.split("\\s+");
    StringBuilder clean = new StringBuilder();
    for (String part : parts) {
      String token = part.replaceAll("^[^A-Za-z0-9]+|[^A-Za-z0-9]+$", "");
      if (TextUtils.isEmpty(token)) {
        continue;
      }

      if (isLikelyReleaseToken(token)) {
        continue;
      }

      if (token.matches("^\\d{1,2}$")) {
        continue;
      }

      if (token.matches("(?i)^[A-Za-z]{4,}\\d{1,4}$")) {
        continue;
      }

      if (token.matches("(?i)^[A-Za-z0-9]{8,}$")
          && token.matches(".*\\d.*")
          && token.matches(".*[A-Za-z].*")
          && !token.matches("(?i).*[aeiou].*")) {
        continue;
      }

      if (token.length() == 1 && Character.isLetter(token.charAt(0))) {
        continue;
      }

      if (clean.length() > 0) {
        clean.append(" ");
      }
      clean.append(token);
    }

    String pretty = clean.length() > 0 ? clean.toString() : decoded;
    pretty = toTitleCase(pretty);

    if (isLikelyOpaqueTokenTitle(pretty)) {
      return "";
    }

    if (pretty.length() > 72) {
      pretty = pretty.substring(0, 72).trim() + "...";
    }

    return pretty;
  }

  private boolean isLikelyOpaqueTokenTitle(String value) {
    if (TextUtils.isEmpty(value)) {
      return false;
    }

    String s = value.trim();
    if (s.length() < 18) {
      return false;
    }

    // Opaque tokens are typically long, space-less, and digit-heavy.
    if (!s.contains(" ")) {
      int letters = 0;
      int digits = 0;
      int vowels = 0;
      for (int i = 0; i < s.length(); i++) {
        char c = s.charAt(i);
        if (Character.isLetter(c)) {
          letters++;
          char lc = Character.toLowerCase(c);
          if (lc == 'a' || lc == 'e' || lc == 'i' || lc == 'o' || lc == 'u') {
            vowels++;
          }
        } else if (Character.isDigit(c)) {
          digits++;
        }
      }

      if (s.length() >= 24) {
        if (s.matches("(?i)^[0-9a-f]{24,}$")) {
          return true;
        }
        float digitRatio = (float) digits / (float) s.length();
        if (digitRatio >= 0.35f) {
          return true;
        }
        if (letters > 0) {
          float vowelRatio = (float) vowels / (float) letters;
          if (vowelRatio < 0.18f) {
            return true;
          }
        }
      }
    }

    return false;
  }

  private boolean isLikelyLowConfidenceUriTitle(String value) {
    if (TextUtils.isEmpty(value)) {
      return true;
    }

    String s = value.trim();
    if (s.matches("(?i)^\\d{1,2}\\s+[a-z]{4,}\\d{1,4}$")) {
      return true;
    }

    if (s.length() <= 10) {
      String[] parts = s.split("\\s+");
      int alphaWordCount = 0;
      for (String part : parts) {
        if (part.matches("(?i)^[a-z]{3,}$")) {
          alphaWordCount++;
        }
      }
      if (alphaWordCount == 0) {
        return true;
      }
    }

    return false;
  }

  private String extractQualityHint(String title) {
    if (TextUtils.isEmpty(title)) {
      return "";
    }

    String lower = title.toLowerCase(Locale.US);
    if (lower.contains("2160") || lower.contains("4k")) {
      return "2160P";
    }
    if (lower.contains("1080")) {
      return "1080P";
    }
    if (lower.contains("720")) {
      return "720P";
    }
    if (lower.contains("hevc") || lower.contains("x265")) {
      return "HEVC";
    }
    if (lower.contains("h264") || lower.contains("x264")) {
      return "H264";
    }
    return "";
  }

  private boolean isLikelyReleaseToken(String token) {
    String lower = token.toLowerCase(Locale.US);

    if (lower.matches("^(19|20)\\d{2}$")
        || lower.matches("^\\d{3,4}p$")
        || lower.matches("^x\\d{3}$")
        || lower.matches("^h\\d{3}$")
        || lower.matches("^\\d{1,2}bit$")
        || lower.matches("^ddp?\\d?(\\.\\d)?$")
        || lower.matches("^dts(hd|ma)?$")
        || lower.matches("^ac3|eac3|aac\\d?$")) {
      return true;
    }

    switch (lower) {
      case "bluray":
      case "brrip":
      case "bdrip":
      case "web":
      case "webrip":
      case "webdl":
      case "web-dl":
      case "hdrip":
      case "dvdrip":
      case "rip":
      case "proper":
      case "repack":
      case "remux":
      case "hevc":
      case "x264":
      case "x265":
      case "h264":
      case "h265":
      case "hdr":
      case "sdr":
      case "dv":
      case "atvp":
      case "atv":
      case "ntb":
      case "tgx":
      case "amzn":
      case "nf":
      case "hmax":
      case "uhd":
      case "hd":
        return true;
      default:
        return false;
    }
  }

  private String toTitleCase(String value) {
    if (TextUtils.isEmpty(value)) {
      return "";
    }

    String[] words = value.toLowerCase(Locale.US).split("\\s+");
    StringBuilder out = new StringBuilder();
    for (int i = 0; i < words.length; i++) {
      String word = words[i];
      if (word.isEmpty()) {
        continue;
      }

      String finalWord;
      if (word.length() <= 2 && i > 0) {
        // Keep small joiner words lowercase unless they're the first token.
        finalWord = word;
      } else {
        finalWord = Character.toUpperCase(word.charAt(0)) + word.substring(1);
      }

      if (out.length() > 0) {
        out.append(" ");
      }
      out.append(finalWord);
    }
    return out.toString().trim();
  }

  private int dp(int value) {
    return Math.round(value * getResources().getDisplayMetrics().density);
  }

  public boolean isExternalPlayerMode() {
    return mExternalPlayerMode;
  }
}
