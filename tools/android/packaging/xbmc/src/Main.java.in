  private final ExternalPlayerResultCoordinator.MainState mExternalResultProducer =
      new ExternalPlayerResultCoordinator.MainState();
  private final ExternalPlayerResultCoordinator.WarmTaskHandoffController mWarmTaskHandoff;
  private long mLastPlaybackPosition = 0;  // ms
  private long mLastPlaybackDuration = 0;  // ms
  private static final long WARM_TASK_HANDOFF_RETRY_DELAY_MS = 100L;
  private static final long BACK_LONG_PRESS_THRESHOLD_MS = 700L;
  private static final int BACK_SOURCE_GESTURE_LEFT = 0;
  private static final int BACK_SOURCE_GESTURE_RIGHT = 1;
  private static final int BACK_SOURCE_BUTTON = 2;
  private static final String NATIVE_INTENT_RETRY = "jumpgate_native_intent_retry";
  private static final int MAX_NATIVE_INTENT_RETRIES = 1;
