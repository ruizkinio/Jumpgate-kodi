  private static final String TAG = "@APP_NAME@";
  private static final int OVERLAY_ARTWORK_CACHE_KB = 6 * 1024;
  private static final long OVERLAY_ARTWORK_DISK_MAX_BYTES = 20L * 1024L * 1024L;
  private static final int OVERLAY_ARTWORK_DISK_MAX_FILES = 96;
  private static final long OVERLAY_ARTWORK_DISK_MAX_AGE_MS = 14L * 24L * 60L * 60L * 1000L;
  private static final int OVERLAY_ARTWORK_MAX_ENCODED_BYTES = 6 * 1024 * 1024;
  private static final int OVERLAY_ARTWORK_MAX_DIMENSION = 4096;
  private static final long OVERLAY_ARTWORK_MAX_PIXELS = 16L * 1024L * 1024L;
  private static final int OVERLAY_ARTWORK_MAX_REDIRECTS = 2;
  private static final long OVERLAY_SURFACE_FRAME_MS = 33L;
  private static final LruCache<String, Bitmap> sOverlayArtworkCache =
      new LruCache<String, Bitmap>(OVERLAY_ARTWORK_CACHE_KB) {
    @Override
    protected int sizeOf(String key, Bitmap value) {
      if (value == null) {
        return 1;
      }
      int bytes = value.getByteCount();
      int kb = bytes / 1024;
      return kb > 0 ? kb : 1;
    }
  };

