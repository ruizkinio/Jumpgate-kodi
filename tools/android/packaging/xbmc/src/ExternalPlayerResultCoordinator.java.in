package @APP_PACKAGE@;

import java.util.UUID;

public final class ExternalPlayerResultCoordinator {
  public static final String ACTION_BINDING = "@APP_PACKAGE@.action.EXTERNAL_PLAYER_RESULT_BINDING";
  public static final String ACTION_RESULT = "@APP_PACKAGE@.action.EXTERNAL_PLAYER_RESULT";
  public static final String ACTION_MAIN_DESTROYED =
      "@APP_PACKAGE@.action.EXTERNAL_PLAYER_MAIN_DESTROYED";
  public static final String EXTRA_REQUEST_ID = "jumpgate_external_result_request_id";
  public static final String EXTRA_GENERATION = "jumpgate_external_result_generation";
  public static final String EXTRA_POSITION_MS = "jumpgate_external_result_position_ms";
  public static final String EXTRA_DURATION_MS = "jumpgate_external_result_duration_ms";
  public static final String EXTRA_COMPLETED = "jumpgate_external_result_completed";
  public static final String EXTRA_EXIT_PROCESS = "jumpgate_external_result_exit_process";

  private ExternalPlayerResultCoordinator() {}

  public static String createRequestId() {
    return UUID.randomUUID().toString();
  }

  public static boolean isValidRequestId(String requestId) {
    if (requestId == null || requestId.length() != 36) return false;

    try {
      return UUID.fromString(requestId).toString().equalsIgnoreCase(requestId);
    } catch (IllegalArgumentException e) {
      return false;
    }
  }

  public static final class Terminal {
    public final String requestId;
    public final long generation;
    public final long positionMs;
    public final long durationMs;
    public final boolean completed;
    public final boolean exitProcess;

    public Terminal(
        String requestId,
        long generation,
        long positionMs,
        long durationMs,
        boolean completed,
        boolean exitProcess) {
      if (!isValidRequestId(requestId) || generation <= 0)
        throw new IllegalArgumentException("Invalid external-player terminal owner");

      this.requestId = requestId;
      this.generation = generation;
      this.positionMs = Math.max(0, positionMs);
      this.durationMs = Math.max(0, durationMs);
      this.completed = completed;
      this.exitProcess = exitProcess;
    }

    public boolean failedToStart() {
      return !completed && positionMs <= 0 && durationMs <= 0;
    }
  }

  public static final class Admission {
    private final long mGeneration;
    private final String mRequestId;
    private final boolean mCancellationRequested;

    private Admission(long generation, String requestId, boolean cancellationRequested) {
      mGeneration = generation;
      mRequestId = requestId;
      mCancellationRequested = cancellationRequested;
    }

    public long generation() {
      return mGeneration;
    }

    public String requestId() {
      return mRequestId;
    }

    public boolean wasCancellationRequested() {
      return mCancellationRequested;
    }
  }

  public static final class TerminalReservation {
    private final Producer mProducer;
    private final Terminal mTerminal;
    private final boolean mPreparedRejection;
    private boolean mOpen = true;

    private TerminalReservation(
        Producer producer, Terminal terminal, boolean preparedRejection) {
      mProducer = producer;
      mTerminal = terminal;
      mPreparedRejection = preparedRejection;
    }

    public Terminal terminal() {
      return mTerminal;
    }

    public boolean commit() {
      return mProducer.commit(this);
    }

    public boolean rollback() {
      return mProducer.rollback(this);
    }
  }

  public static final class ProcessExitState {
    private String mRequestId;
    private long mGeneration;
    private boolean mExitRequested;
    private boolean mAcknowledged;
    private boolean mClaimed;

    public ProcessExitState() {
      mRequestId = "";
    }

    public ProcessExitState(
        String requestId,
        long generation,
        boolean exitRequested,
        boolean acknowledged,
        boolean claimed) {
      if (!isValidRequestId(requestId)
          || generation <= 0
          || (acknowledged && !exitRequested)
          || (claimed && !acknowledged))
        throw new IllegalArgumentException("Invalid external-player process-exit state");

      mRequestId = requestId;
      mGeneration = generation;
      mExitRequested = exitRequested;
      mAcknowledged = acknowledged;
      mClaimed = claimed;
    }

    public synchronized boolean activate(long generation, String requestId) {
      if (generation <= 0 || !isValidRequestId(requestId)) return false;
      if (matches(generation, requestId)) return true;

      mRequestId = requestId;
      mGeneration = generation;
      mExitRequested = false;
      mAcknowledged = false;
      mClaimed = false;
      return true;
    }

    public synchronized boolean requestExit(long generation, String requestId) {
      if (!matches(generation, requestId) || mExitRequested) return false;

      mExitRequested = true;
      return true;
    }

    public synchronized boolean acknowledge(long generation, String requestId) {
      if (!matches(generation, requestId) || !mExitRequested || mAcknowledged) return false;

      mAcknowledged = true;
      return true;
    }

    public synchronized boolean claim(long generation, String requestId) {
      if (!matches(generation, requestId) || !mAcknowledged || mClaimed) return false;

      mClaimed = true;
      return true;
    }

    public synchronized boolean clear(long generation, String requestId) {
      if (!matches(generation, requestId)) return false;

      mRequestId = "";
      mGeneration = 0;
      mExitRequested = false;
      mAcknowledged = false;
      mClaimed = false;
      return true;
    }

    public synchronized boolean matches(long generation, String requestId) {
      return generation > 0 && generation == mGeneration && mRequestId.equals(requestId);
    }

    public synchronized boolean isAcknowledged(long generation, String requestId) {
      return matches(generation, requestId) && mAcknowledged;
    }

    public synchronized boolean isClaimed(long generation, String requestId) {
      return matches(generation, requestId) && mClaimed;
    }

    public synchronized ProcessExitState copy() {
      if (mGeneration == 0) return new ProcessExitState();
      return new ProcessExitState(mRequestId, mGeneration, mExitRequested, mAcknowledged, mClaimed);
    }

    public synchronized boolean isActive() {
      return mGeneration > 0;
    }

    public synchronized String requestId() {
      return mRequestId;
    }

    public synchronized long generation() {
      return mGeneration;
    }

    public synchronized boolean wasExitRequested() {
      return mExitRequested;
    }

    public synchronized boolean wasAcknowledged() {
      return mAcknowledged;
    }

    public synchronized boolean wasClaimed() {
      return mClaimed;
    }
  }

  public static final class Producer {
    private long mGeneration;
    private String mRequestId = "";
    private boolean mTerminalClaimed;
    private boolean mExitProcess;
    private boolean mExitAcknowledged;
    private boolean mExitScheduled;
    private boolean mOwnerCanceled;
    private String mPreparedRequestId = "";
    private boolean mPreparedCancellation;
    private TerminalReservation mTerminalReservation;

    public synchronized boolean prepare(String requestId) {
      if (!isValidRequestId(requestId)) return false;
      if (!mPreparedRequestId.isEmpty()) return mPreparedRequestId.equals(requestId);
      if (mGeneration > 0 && mRequestId.equals(requestId)) return true;

      mPreparedRequestId = requestId;
      mPreparedCancellation = false;
      return true;
    }

    public synchronized boolean cancelPrepared(String requestId) {
      if (!isValidRequestId(requestId) || !mPreparedRequestId.equals(requestId)) return false;

      mPreparedCancellation = true;
      return true;
    }

    public synchronized Admission admitPrepared(long generation, String requestId) {
      if (generation <= mGeneration
          || !isValidRequestId(requestId)
          || !mPreparedRequestId.equals(requestId)
          || mTerminalReservation != null
          || (mGeneration > 0 && !mTerminalClaimed)) return null;

      boolean cancellationRequested = mPreparedCancellation;
      if (!begin(generation, requestId)) return null;
      mPreparedRequestId = "";
      mPreparedCancellation = false;
      mOwnerCanceled = cancellationRequested;
      return new Admission(generation, requestId, cancellationRequested);
    }

    public synchronized TerminalReservation reservePreparedRejection(
        long generation, String requestId) {
      if (generation <= 0
          || !isValidRequestId(requestId)
          || !mPreparedRequestId.equals(requestId)
          || mTerminalReservation != null) return null;

      return reserve(new Terminal(requestId, generation, 0, 0, false, false), true);
    }

    public synchronized Terminal rejectPrepared(long generation, String requestId) {
      TerminalReservation reservation = reservePreparedRejection(generation, requestId);
      if (reservation == null) return null;

      Terminal terminal = reservation.terminal();
      if (reservation.commit()) return terminal;
      reservation.rollback();
      return null;
    }

    public synchronized boolean begin(long generation, String requestId) {
      if (generation <= mGeneration
          || !isValidRequestId(requestId)
          || mTerminalReservation != null
          || (mGeneration > 0 && !mTerminalClaimed)) return false;

      mGeneration = generation;
      mRequestId = requestId;
      mTerminalClaimed = false;
      mExitProcess = false;
      mExitAcknowledged = false;
      mExitScheduled = false;
      mOwnerCanceled = false;
      return true;
    }

    public synchronized TerminalReservation reserveFinish(
        long generation,
        String requestId,
        long positionMs,
        long durationMs,
        boolean completed,
        boolean exitProcess) {
      if (!matches(generation, requestId)
          || mTerminalClaimed
          || mTerminalReservation != null) return null;

      return reserve(
          new Terminal(
              requestId, generation, positionMs, durationMs, completed, exitProcess),
          false);
    }

    public synchronized Terminal finish(
        long generation,
        String requestId,
        long positionMs,
        long durationMs,
        boolean completed,
        boolean exitProcess) {
      TerminalReservation reservation =
          reserveFinish(
              generation, requestId, positionMs, durationMs, completed, exitProcess);
      if (reservation == null) return null;

      Terminal terminal = reservation.terminal();
      if (reservation.commit()) return terminal;
      reservation.rollback();
      return null;
    }

    public synchronized TerminalReservation reserveSupersede(
        long generation, String requestId) {
      return reserveFinish(generation, requestId, 0, 0, false, false);
    }

    public synchronized Terminal supersede(long generation, String requestId) {
      return finish(generation, requestId, 0, 0, false, false);
    }

    public synchronized boolean matches(long generation, String requestId) {
      return generation > 0 && generation == mGeneration && mRequestId.equals(requestId);
    }

    public synchronized boolean ownsRequest(String requestId) {
      return (mGeneration > 0 && mRequestId.equals(requestId))
          || (!mPreparedRequestId.isEmpty() && mPreparedRequestId.equals(requestId));
    }

    public synchronized boolean isPrepared(String requestId) {
      return isValidRequestId(requestId) && mPreparedRequestId.equals(requestId);
    }

    public synchronized long activeGeneration() {
      return mGeneration;
    }

    public synchronized String activeRequestId() {
      return mRequestId;
    }

    public synchronized String preparedRequestId() {
      return mPreparedRequestId;
    }

    public synchronized boolean acknowledgeExit(long generation, String requestId) {
      if (!matches(generation, requestId) || !mTerminalClaimed || !mExitProcess) return false;

      mExitAcknowledged = true;
      return true;
    }

    public synchronized boolean cancelOwner(long generation, String requestId) {
      if (!matches(generation, requestId)) return false;

      mOwnerCanceled = true;
      return true;
    }

    public synchronized boolean isOwnerCanceled(long generation, String requestId) {
      return matches(generation, requestId) && mOwnerCanceled;
    }

    public synchronized boolean claimProcessExit(long generation, String requestId) {
      if (!matches(generation, requestId)
          || !mTerminalClaimed
          || !mExitProcess
          || (!mExitAcknowledged && !mOwnerCanceled)
          || mExitScheduled) return false;

      mExitScheduled = true;
      return true;
    }

    public synchronized boolean shouldExitProcess(long generation, String requestId) {
      return matches(generation, requestId) && mExitScheduled && mExitProcess;
    }

    public synchronized void clear(long generation, String requestId) {
      if (!matches(generation, requestId) || mTerminalReservation != null) return;

      mGeneration = 0;
      mRequestId = "";
      mTerminalClaimed = false;
      mExitProcess = false;
      mExitAcknowledged = false;
      mExitScheduled = false;
      mOwnerCanceled = false;
      if (mPreparedRequestId.equals(requestId)) {
        mPreparedRequestId = "";
        mPreparedCancellation = false;
      }
    }

    private TerminalReservation reserve(Terminal terminal, boolean preparedRejection) {
      TerminalReservation reservation =
          new TerminalReservation(this, terminal, preparedRejection);
      mTerminalReservation = reservation;
      return reservation;
    }

    private synchronized boolean commit(TerminalReservation reservation) {
      if (!isOpenReservation(reservation)) return false;

      Terminal terminal = reservation.mTerminal;
      if (reservation.mPreparedRejection) {
        if (!mPreparedRequestId.equals(terminal.requestId)) return false;
        mPreparedRequestId = "";
        mPreparedCancellation = false;
      } else {
        if (!matches(terminal.generation, terminal.requestId) || mTerminalClaimed) return false;
        mTerminalClaimed = true;
        mExitProcess = terminal.exitProcess;
      }

      close(reservation);
      return true;
    }

    private synchronized boolean rollback(TerminalReservation reservation) {
      if (!isOpenReservation(reservation)) return false;

      close(reservation);
      return true;
    }

    private boolean isOpenReservation(TerminalReservation reservation) {
      return reservation != null
          && reservation.mProducer == this
          && reservation.mOpen
          && mTerminalReservation == reservation;
    }

    private void close(TerminalReservation reservation) {
      reservation.mOpen = false;
      mTerminalReservation = null;
    }
  }

  public static final class MainState {
    private final Producer mProducer = new Producer();

    public synchronized boolean ownsRequest(String requestId) {
      return mProducer.ownsRequest(requestId);
    }

    public synchronized boolean prepare(String requestId) {
      return mProducer.prepare(requestId);
    }

    public synchronized boolean isPrepared(String requestId) {
      return mProducer.isPrepared(requestId);
    }

    public synchronized Admission admitPrepared(long generation, String requestId) {
      return mProducer.admitPrepared(generation, requestId);
    }

    public synchronized TerminalReservation reservePreparedRejection(
        long generation, String requestId) {
      return mProducer.reservePreparedRejection(generation, requestId);
    }

    public synchronized Terminal rejectPrepared(long generation, String requestId) {
      return mProducer.rejectPrepared(generation, requestId);
    }

    public synchronized Terminal supersede(long generation, String requestId) {
      return mProducer.supersede(generation, requestId);
    }

    public synchronized TerminalReservation reserveSupersede(
        long generation, String requestId) {
      return mProducer.reserveSupersede(generation, requestId);
    }

    public synchronized TerminalReservation reserveFinish(
        long generation,
        String requestId,
        long positionMs,
        long durationMs,
        boolean completed,
        boolean exitProcess) {
      return mProducer.reserveFinish(
          generation, requestId, positionMs, durationMs, completed, exitProcess);
    }

    public synchronized Terminal finish(
        long generation,
        String requestId,
        long positionMs,
        long durationMs,
        boolean completed,
        boolean exitProcess) {
      return mProducer.finish(
          generation, requestId, positionMs, durationMs, completed, exitProcess);
    }

    public synchronized boolean cancelEarlyBack() {
      String preparedRequestId = mProducer.preparedRequestId();
      if (isValidRequestId(preparedRequestId)
          && mProducer.cancelPrepared(preparedRequestId)) return true;
      return mProducer.activeGeneration() > 0
          && mProducer.cancelOwner(mProducer.activeGeneration(), mProducer.activeRequestId());
    }

    public synchronized boolean cancelOwner(long generation, String requestId) {
      return mProducer.cancelOwner(generation, requestId);
    }

    public synchronized boolean isOwnerCanceled(long generation, String requestId) {
      return mProducer.isOwnerCanceled(generation, requestId);
    }

    public synchronized boolean acknowledgeExit(long generation, String requestId) {
      return mProducer.acknowledgeExit(generation, requestId);
    }

    public synchronized boolean claimProcessExit(long generation, String requestId) {
      return mProducer.claimProcessExit(generation, requestId);
    }

    public synchronized boolean shouldExitProcess(long generation, String requestId) {
      return mProducer.shouldExitProcess(generation, requestId);
    }

    public synchronized void clear(long generation, String requestId) {
      mProducer.clear(generation, requestId);
    }

    public synchronized long activeGeneration() {
      return mProducer.activeGeneration();
    }

    public synchronized String activeRequestId() {
      return mProducer.activeRequestId();
    }

    public synchronized String preparedRequestId() {
      return mProducer.preparedRequestId();
    }
  }

  public static final class Owner {
    private final String mRequestId;
    private boolean mLaunchForwarded;
    private long mExpectedGeneration;
    private boolean mCompleted;
    private boolean mCanceled;

    public Owner(
        String requestId,
        boolean launchForwarded,
        long expectedGeneration,
        boolean completed,
        boolean canceled) {
      if (!isValidRequestId(requestId)
          || expectedGeneration < 0
          || (expectedGeneration > 0 && !launchForwarded)
          || (canceled && !completed))
        throw new IllegalArgumentException("Invalid external-player result owner");

      mRequestId = requestId;
      mLaunchForwarded = launchForwarded;
      mExpectedGeneration = expectedGeneration;
      mCompleted = completed;
      mCanceled = canceled;
    }

    public synchronized boolean markLaunchForwarded() {
      if (mCompleted || mLaunchForwarded) return false;

      mLaunchForwarded = true;
      return true;
    }

    public synchronized boolean rollbackLaunchForwarded() {
      if (mCompleted || !mLaunchForwarded || mExpectedGeneration != 0) return false;

      mLaunchForwarded = false;
      return true;
    }

    public synchronized boolean bind(long generation, String requestId) {
      if (!mLaunchForwarded
          || generation <= 0
          || !mRequestId.equals(requestId)
          || (mExpectedGeneration != 0 && mExpectedGeneration != generation)) return false;

      mExpectedGeneration = generation;
      return true;
    }

    public synchronized boolean claim(Terminal terminal) {
      if (mCompleted || !matches(terminal)) return false;

      mCompleted = true;
      return true;
    }

    public synchronized boolean cancelBeforeAdmission() {
      if (mCompleted || mExpectedGeneration != 0) return false;

      mCompleted = true;
      mCanceled = true;
      return true;
    }

    public synchronized boolean cancel(long generation, String requestId) {
      if (mCompleted
          || generation <= 0
          || generation != mExpectedGeneration
          || !mRequestId.equals(requestId)) return false;

      mCompleted = true;
      mCanceled = true;
      return true;
    }

    public synchronized boolean matches(Terminal terminal) {
      return terminal != null
          && mExpectedGeneration > 0
          && mExpectedGeneration == terminal.generation
          && mRequestId.equals(terminal.requestId);
    }

    public synchronized Owner copy() {
      return new Owner(mRequestId, mLaunchForwarded, mExpectedGeneration, mCompleted, mCanceled);
    }

    public String requestId() {
      return mRequestId;
    }

    public synchronized boolean wasLaunchForwarded() {
      return mLaunchForwarded;
    }

    public synchronized long expectedGeneration() {
      return mExpectedGeneration;
    }

    public synchronized boolean wasCompleted() {
      return mCompleted;
    }

    public synchronized boolean wasCanceled() {
      return mCanceled;
    }
  }
}
