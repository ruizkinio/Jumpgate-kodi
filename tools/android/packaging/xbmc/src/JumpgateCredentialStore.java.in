package @APP_PACKAGE@;

import android.content.Context;
import android.security.keystore.KeyGenParameterSpec;
import android.security.keystore.KeyProperties;
import android.system.ErrnoException;
import android.system.Os;
import android.system.OsConstants;
import android.util.Base64;
import android.util.Log;

import java.io.DataInputStream;
import java.io.DataOutputStream;
import java.io.File;
import java.io.FileInputStream;
import java.io.FileOutputStream;
import java.io.FileDescriptor;
import java.io.IOException;
import java.nio.charset.StandardCharsets;
import java.security.GeneralSecurityException;
import java.security.InvalidKeyException;
import java.security.Key;
import java.security.KeyStore;
import java.security.SecureRandom;
import java.security.UnrecoverableKeyException;
import java.util.Arrays;
import java.util.regex.Pattern;

import javax.crypto.Cipher;
import javax.crypto.KeyGenerator;
import javax.crypto.SecretKey;
import javax.crypto.spec.GCMParameterSpec;

/** Stores Jumpgate bearer material in an AndroidKeyStore-backed AES-GCM envelope. */
public final class JumpgateCredentialStore
{
  private static final String TAG = "JumpgateCredentialStore";
  private static final String KEYSTORE = "AndroidKeyStore";
  private static final String KEY_ALIAS_SUFFIX = ".jumpgate.profile.aes_gcm.v1";
  private static final String PROFILE_NAMESPACE = "jumpgate.profile";
  private static final String CREDENTIAL_DIRECTORY = "jumpgate_credentials_v1";
  private static final String CREDENTIAL_EXTENSION = ".jgc";
  private static final String CREDENTIAL_PREFIX = "jgcred_";
  private static final String TRANSFORMATION = "AES/GCM/NoPadding";
  private static final int ENVELOPE_MAGIC = 0x4a474331; // JGC1
  private static final int ENVELOPE_VERSION = 1;
  private static final int GCM_TAG_BITS = 128;
  private static final int MAX_PLAINTEXT_BYTES = 2 * 1024 * 1024;
  private static final int MAX_ENVELOPE_BYTES = MAX_PLAINTEXT_BYTES + 4096;
  private static final Pattern IDENTIFIER = Pattern.compile("^[A-Za-z0-9_-]{8,128}$");
  private static final Pattern CREDENTIAL_REF =
      Pattern.compile("^jgcred_[A-Za-z0-9_-]{16,128}$");
  private static final SecureRandom RANDOM = new SecureRandom();

  private JumpgateCredentialStore()
  {
  }

  public static synchronized String store(Context context,
                                          String profileNamespace,
                                          String profileId,
                                          String deviceId,
                                          String secretJson)
  {
    if (!validScope(context, profileNamespace, profileId, deviceId) || secretJson == null)
      return null;

    byte[] plaintext = secretJson.getBytes(StandardCharsets.UTF_8);
    byte[] aad = associatedData(context, profileNamespace, profileId, deviceId);
    byte[] ciphertext = null;
    byte[] iv = null;
    File temporary = null;
    File destination = null;
    boolean committed = false;
    try
    {
      if (plaintext.length == 0 || plaintext.length > MAX_PLAINTEXT_BYTES)
        return null;

      Cipher cipher = encryptionCipher(context);
      cipher.updateAAD(aad);
      ciphertext = cipher.doFinal(plaintext);
      iv = cipher.getIV();
      if (iv == null || iv.length < 12 || iv.length > 32 || ciphertext.length < 16)
        return null;

      File directory = credentialDirectory(context);
      if (!directory.exists() && !directory.mkdirs())
        return null;
      if (!directory.isDirectory())
        return null;

      for (int attempt = 0; attempt < 8; ++attempt)
      {
        String credentialRef = newCredentialRef();
        destination = new File(directory, credentialRef + CREDENTIAL_EXTENSION);
        if (destination.exists())
        {
          destination = null;
          continue;
        }
        temporary = new File(directory, credentialRef + ".tmp");
        if (temporary.exists())
          deleteAndSync(temporary);

        writeEnvelope(temporary, iv, ciphertext);
        if (!temporary.renameTo(destination))
          throw new IOException("Credential envelope atomic replacement failed");
        temporary = null;
        syncDirectory(directory);
        committed = true;
        return credentialRef;
      }
    }
    catch (GeneralSecurityException | IOException | RuntimeException ignored)
    {
      Log.e(TAG, "Credential encryption failed closed");
    }
    finally
    {
      if (temporary != null)
        cleanupAfterFailure(temporary);
      if (destination != null && !committed)
        cleanupAfterFailure(destination);
      Arrays.fill(plaintext, (byte) 0);
      Arrays.fill(aad, (byte) 0);
      if (ciphertext != null)
        Arrays.fill(ciphertext, (byte) 0);
      if (iv != null)
        Arrays.fill(iv, (byte) 0);
    }
    return null;
  }

  public static synchronized String load(Context context,
                                         String profileNamespace,
                                         String profileId,
                                         String deviceId,
                                         String credentialRef)
  {
    if (!validScope(context, profileNamespace, profileId, deviceId) ||
        !validCredentialRef(credentialRef))
      return null;

    byte[] aad = associatedData(context, profileNamespace, profileId, deviceId);
    byte[] iv = null;
    byte[] ciphertext = null;
    byte[] plaintext = null;
    try
    {
      File envelopeFile = credentialFile(context, credentialRef);
      Envelope envelope = readEnvelope(envelopeFile);
      if (envelope == null)
        return null;
      iv = envelope.iv;
      ciphertext = envelope.ciphertext;

      SecretKey key = existingKey(context);
      if (key == null)
        return null;
      Cipher cipher = Cipher.getInstance(TRANSFORMATION);
      cipher.init(Cipher.DECRYPT_MODE, key, new GCMParameterSpec(GCM_TAG_BITS, iv));
      cipher.updateAAD(aad);
      plaintext = cipher.doFinal(ciphertext);
      if (plaintext.length == 0 || plaintext.length > MAX_PLAINTEXT_BYTES)
        return null;
      return new String(plaintext, StandardCharsets.UTF_8);
    }
    catch (GeneralSecurityException | IOException | RuntimeException ignored)
    {
      Log.e(TAG, "Credential authentication failed; re-pairing is required");
      return null;
    }
    finally
    {
      Arrays.fill(aad, (byte) 0);
      if (iv != null)
        Arrays.fill(iv, (byte) 0);
      if (ciphertext != null)
        Arrays.fill(ciphertext, (byte) 0);
      if (plaintext != null)
        Arrays.fill(plaintext, (byte) 0);
    }
  }

  public static synchronized boolean remove(Context context,
                                            String profileNamespace,
                                            String credentialRef)
  {
    if (context == null || !PROFILE_NAMESPACE.equals(profileNamespace) ||
        !validCredentialRef(credentialRef))
      return false;
    try
    {
      File file = credentialFile(context, credentialRef);
      if (file.exists())
        deleteAndSync(file);
      return true;
    }
    catch (IOException | RuntimeException ignored)
    {
      Log.e(TAG, "Credential cleanup failed");
      return false;
    }
  }

  private static Cipher encryptionCipher(Context context) throws GeneralSecurityException, IOException
  {
    try
    {
      // Encryption mode asks the provider to generate a fresh random IV.
      SecretKey key = getOrCreateKey(context);
      Cipher cipher = Cipher.getInstance(TRANSFORMATION);
      cipher.init(Cipher.ENCRYPT_MODE, key);
      return cipher;
    }
    catch (InvalidKeyException | UnrecoverableKeyException invalidated)
    {
      // Store is called only during explicit pairing. Recreate an unusable key so re-pair can recover.
      deleteKeyAndInvalidEnvelopes(context);
      SecretKey key = generateKey(context);
      Cipher cipher = Cipher.getInstance(TRANSFORMATION);
      cipher.init(Cipher.ENCRYPT_MODE, key);
      return cipher;
    }
  }

  private static SecretKey getOrCreateKey(Context context)
      throws GeneralSecurityException, IOException
  {
    KeyStore keyStore = loadKeyStore();
    String alias = keyAlias(context);
    if (keyStore.containsAlias(alias))
    {
      Key key = keyStore.getKey(alias, null);
      if (!(key instanceof SecretKey))
        throw new InvalidKeyException("Unexpected AndroidKeyStore entry type");
      return (SecretKey) key;
    }
    deleteCredentialEnvelopes(context);
    return generateKey(context);
  }

  private static SecretKey existingKey(Context context)
      throws GeneralSecurityException, IOException
  {
    KeyStore keyStore = loadKeyStore();
    String alias = keyAlias(context);
    if (!keyStore.containsAlias(alias))
      return null;
    Key key = keyStore.getKey(alias, null);
    return key instanceof SecretKey ? (SecretKey) key : null;
  }

  private static SecretKey generateKey(Context context) throws GeneralSecurityException
  {
    KeyGenerator generator = KeyGenerator.getInstance(KeyProperties.KEY_ALGORITHM_AES, KEYSTORE);
    KeyGenParameterSpec specification = new KeyGenParameterSpec.Builder(
        keyAlias(context), KeyProperties.PURPOSE_ENCRYPT | KeyProperties.PURPOSE_DECRYPT)
        .setKeySize(256)
        .setBlockModes(KeyProperties.BLOCK_MODE_GCM)
        .setEncryptionPaddings(KeyProperties.ENCRYPTION_PADDING_NONE)
        .setRandomizedEncryptionRequired(true)
        .build();
    generator.init(specification);
    return generator.generateKey();
  }

  private static KeyStore loadKeyStore() throws GeneralSecurityException, IOException
  {
    KeyStore keyStore = KeyStore.getInstance(KEYSTORE);
    keyStore.load(null);
    return keyStore;
  }

  private static void deleteKeyAndInvalidEnvelopes(Context context)
      throws GeneralSecurityException, IOException
  {
    KeyStore keyStore = loadKeyStore();
    String alias = keyAlias(context);
    if (keyStore.containsAlias(alias))
      keyStore.deleteEntry(alias);

    deleteCredentialEnvelopes(context);
  }

  private static void deleteCredentialEnvelopes(Context context) throws IOException
  {
    File directory = credentialDirectory(context);
    if (!directory.exists())
      return;
    if (!directory.isDirectory())
      throw new IOException("Credential storage path is not a directory");
    File[] files = directory.listFiles();
    if (files == null)
      throw new IOException("Credential storage directory cannot be read");
    boolean deleted = false;
    for (File file : files)
    {
      if (file.isFile() &&
          (file.getName().endsWith(CREDENTIAL_EXTENSION) || file.getName().endsWith(".tmp")))
      {
        if (!file.delete())
          throw new IOException("Credential envelope cleanup failed");
        deleted = true;
      }
    }
    if (deleted)
      syncDirectory(directory);
  }

  private static byte[] associatedData(Context context,
                                       String profileNamespace,
                                       String profileId,
                                       String deviceId)
  {
    String binding = context.getPackageName() + "\u0000" + profileNamespace + "\u0000" +
                     profileId + "\u0000" + deviceId;
    return binding.getBytes(StandardCharsets.UTF_8);
  }

  private static boolean validScope(Context context,
                                    String profileNamespace,
                                    String profileId,
                                    String deviceId)
  {
    return context != null && PROFILE_NAMESPACE.equals(profileNamespace) &&
           profileId != null && IDENTIFIER.matcher(profileId).matches() &&
           deviceId != null && IDENTIFIER.matcher(deviceId).matches();
  }

  private static boolean validCredentialRef(String credentialRef)
  {
    return credentialRef != null && CREDENTIAL_REF.matcher(credentialRef).matches();
  }

  private static String newCredentialRef()
  {
    byte[] random = new byte[24];
    RANDOM.nextBytes(random);
    try
    {
      return CREDENTIAL_PREFIX + Base64.encodeToString(
          random, Base64.URL_SAFE | Base64.NO_WRAP | Base64.NO_PADDING);
    }
    finally
    {
      Arrays.fill(random, (byte) 0);
    }
  }

  private static String keyAlias(Context context)
  {
    return context.getPackageName() + KEY_ALIAS_SUFFIX;
  }

  private static File credentialDirectory(Context context)
  {
    return new File(context.getNoBackupFilesDir(), CREDENTIAL_DIRECTORY);
  }

  private static File credentialFile(Context context, String credentialRef)
  {
    return new File(credentialDirectory(context), credentialRef + CREDENTIAL_EXTENSION);
  }

  private static void writeEnvelope(File file, byte[] iv, byte[] ciphertext) throws IOException
  {
    try (FileOutputStream fileOutput = new FileOutputStream(file, false);
         DataOutputStream output = new DataOutputStream(fileOutput))
    {
      output.writeInt(ENVELOPE_MAGIC);
      output.writeByte(ENVELOPE_VERSION);
      output.writeByte(iv.length);
      output.writeInt(ciphertext.length);
      output.write(iv);
      output.write(ciphertext);
      output.flush();
      fileOutput.getFD().sync();
    }
  }

  private static void deleteAndSync(File file) throws IOException
  {
    if (!file.exists())
      return;
    File directory = file.getParentFile();
    if (!file.delete())
      throw new IOException("Credential envelope cleanup failed");
    if (directory != null && directory.isDirectory())
      syncDirectory(directory);
  }

  private static void cleanupAfterFailure(File file)
  {
    try
    {
      deleteAndSync(file);
    }
    catch (IOException | RuntimeException ignored)
    {
      Log.e(TAG, "Credential cleanup durability failed");
    }
  }

  private static void syncDirectory(File directory) throws IOException
  {
    FileDescriptor descriptor;
    try
    {
      descriptor = Os.open(directory.getAbsolutePath(),
                           OsConstants.O_RDONLY | OsConstants.O_CLOEXEC,
                           0);
    }
    catch (ErrnoException error)
    {
      throw new IOException("Credential directory could not be opened for sync", error);
    }

    IOException failure = null;
    try
    {
      if (!OsConstants.S_ISDIR(Os.fstat(descriptor).st_mode))
        failure = new IOException("Credential sync target is not a directory");
      else
        Os.fsync(descriptor);
    }
    catch (ErrnoException error)
    {
      failure = new IOException("Credential directory sync failed", error);
    }
    try
    {
      Os.close(descriptor);
    }
    catch (ErrnoException error)
    {
      IOException closeFailure = new IOException("Credential directory close failed", error);
      if (failure == null)
        failure = closeFailure;
      else
        failure.addSuppressed(closeFailure);
    }
    if (failure != null)
      throw failure;
  }

  private static Envelope readEnvelope(File file) throws IOException
  {
    if (!file.isFile() || file.length() < 38 || file.length() > MAX_ENVELOPE_BYTES)
      return null;
    try (DataInputStream input = new DataInputStream(new FileInputStream(file)))
    {
      if (input.readInt() != ENVELOPE_MAGIC || input.readUnsignedByte() != ENVELOPE_VERSION)
        return null;
      int ivLength = input.readUnsignedByte();
      int ciphertextLength = input.readInt();
      if (ivLength < 12 || ivLength > 32 || ciphertextLength < 16 ||
          ciphertextLength > MAX_ENVELOPE_BYTES ||
          file.length() != 10L + ivLength + ciphertextLength)
        return null;
      byte[] iv = new byte[ivLength];
      byte[] ciphertext = new byte[ciphertextLength];
      input.readFully(iv);
      input.readFully(ciphertext);
      if (input.read() != -1)
      {
        Arrays.fill(iv, (byte) 0);
        Arrays.fill(ciphertext, (byte) 0);
        return null;
      }
      return new Envelope(iv, ciphertext);
    }
  }

  private static final class Envelope
  {
    private final byte[] iv;
    private final byte[] ciphertext;

    private Envelope(byte[] iv, byte[] ciphertext)
    {
      this.iv = iv;
      this.ciphertext = ciphertext;
    }
  }
}
