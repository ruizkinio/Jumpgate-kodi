apply plugin: 'com.android.application'

android {
    namespace = '@APP_PACKAGE@'
    compileSdk = @TARGET_SDK@
    ndkPath = "@NDKROOT@"
    ndkVersion = "@NDKVERSION@"
    defaultConfig {
        applicationId = "@APP_PACKAGE@"
        minSdk = @TARGET_MINSDK@
        targetSdk = @TARGET_SDK@
        versionCode = @APP_VERSION_CODE_ANDROID@
        versionName = "@APP_VERSION@"
    }
    signingConfigs {
        release {
            keyAlias = System.getenv("KODI_ANDROID_KEY_ALIAS")
            keyPassword = System.getenv("KODI_ANDROID_KEY_PASSWORD")
            storeFile = file(System.getenv("KODI_ANDROID_STORE_FILE"))
            storePassword = System.getenv("KODI_ANDROID_STORE_PASSWORD")
            enableV1Signing = true
            enableV2Signing = true
            enableV3Signing = true
        }
    }
    buildTypes {
        debug {
            signingConfig = signingConfigs.release
        }
        relwithdebinfo {
            signingConfig = signingConfigs.release
        }
        release {
            signingConfig = signingConfigs.release
        }
    }
    aaptOptions {
        ignoreAssetsPattern = '!.svn:!.git:!.ds_store:!*.scc:.*:!CVS:!thumbs.db:!picasa.ini:!*~'
    }
    sourceSets {
        main {
            manifest.srcFile 'AndroidManifest.xml'
            java.srcDirs = ['java']
            res.srcDirs = ['res']
            assets.srcDirs = ['assets']
            jniLibs.srcDirs = ['lib']
        }
        test {
            java.srcDirs = ['test']
        }
    }
    packagingOptions{
      doNotStrip '**.setup'
      jniLibs {
          useLegacyPackaging = true
      }
    }
}

project.afterEvaluate {
    preBuild.dependsOn
}

dependencies {
    implementation 'androidx.core:core:1.16.0'
    implementation 'androidx.tvprovider:tvprovider:1.1.0'
    implementation 'com.google.code.gson:gson:2.13.1'
}

java {
    toolchain {
        languageVersion = JavaLanguageVersion.of(17)
    }
}

def androidApi36Jar = file("${android.sdkDirectory}/platforms/android-36/android.jar")
def externalPlayerTestClasses = layout.buildDirectory.dir('classes/externalPlayerResultTest')

tasks.register('compileExternalPlayerResultTests', JavaCompile) {
    group = 'verification'
    description = 'Strictly compiles the production external-player result seam against API 36.'
    source files(
        'src/ExternalPlayerActivity.java',
        'src/ExternalPlayerResultCoordinator.java',
        'src/ExternalPlayerResultStore.java'
    )
    source fileTree('test') { include '**/*.java' }
    source fileTree('test-support') { include '**/*.java' }
    classpath = files(androidApi36Jar)
    destinationDirectory = externalPlayerTestClasses
    options.release = 17
    options.encoding = 'UTF-8'
    options.compilerArgs.addAll(['-Xlint:all', '-Werror'])
    doFirst {
        if (!androidApi36Jar.isFile()) {
            throw new GradleException("Android API 36 is required: ${androidApi36Jar}")
        }
    }
}

tasks.register('externalPlayerResultTest', JavaExec) {
    group = 'verification'
    description = 'Runs production coordinator race tests and activity-controller behavior tests.'
    dependsOn tasks.named('compileExternalPlayerResultTests')
    classpath = files(externalPlayerTestClasses, androidApi36Jar)
    mainClass = '@APP_PACKAGE@.ExternalPlayerResultCoordinatorTest'
    jvmArgs '-ea'
}

tasks.named('check').configure {
    dependsOn tasks.named('externalPlayerResultTest')
}
