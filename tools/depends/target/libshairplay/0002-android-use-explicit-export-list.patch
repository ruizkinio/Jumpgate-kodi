From: Jumpgate contributors <jumpgate@users.noreply.github.com>
Date: Mon, 13 Jul 2026 20:00:00 +0200
Subject: [PATCH] Use a deterministic Shairplay export allowlist

Recent Android LLVM/libtool combinations can leave the generated export list
empty when -export-symbols-regex is used. Libtool then records
libshairplay.so in its archive metadata but emits only libshairplay.a, making
installation fail when it tries to copy the missing shared object.

Feed libtool the public API names directly instead. This avoids the broken
nm-to-regex path without exposing Shairplay's bundled crypto and HTTP symbols
to Android's process-wide dynamic symbol namespace. Kodi applies this patch
from its dependency recipe on Android only.

---
 src/lib/Makefile.am        | 2 +-
 src/lib/shairplay.exports | 14 ++++++++++++++
 2 files changed, 15 insertions(+), 1 deletion(-)
 create mode 100644 src/lib/shairplay.exports

diff --git a/src/lib/Makefile.am b/src/lib/Makefile.am
index 1f51c33..58979ab 100644
--- a/src/lib/Makefile.am
+++ b/src/lib/Makefile.am
@@ -39,6 +39,6 @@
 if OS_WIN32
 libshairplay_la_CPPFLAGS += -DDLL_EXPORT
 libshairplay_la_LDFLAGS += -lws2_32 -lwinmm
 else
-libshairplay_la_LDFLAGS += -export-symbols-regex '^(raop|dnssd)'
+libshairplay_la_LDFLAGS += -export-symbols $(srcdir)/shairplay.exports
 endif
diff --git a/src/lib/shairplay.exports b/src/lib/shairplay.exports
new file mode 100644
index 0000000..5e3075e
--- /dev/null
+++ b/src/lib/shairplay.exports
@@ -0,0 +1,14 @@
+dnssd_destroy
+dnssd_init
+dnssd_register_airplay
+dnssd_register_raop
+dnssd_unregister_airplay
+dnssd_unregister_raop
+raop_destroy
+raop_init
+raop_init_from_keyfile
+raop_is_running
+raop_set_log_callback
+raop_set_log_level
+raop_start
+raop_stop
